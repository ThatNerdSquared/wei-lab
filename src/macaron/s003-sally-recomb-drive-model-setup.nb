Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sum", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"n", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", "k"}], "]"}], 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"k", ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", "j"}], "]"}], 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{
        RowBox[{"n", "-", "k"}], ",", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", "i"}], "]"}], " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"n", "-", "k", "-", "i"}], ",", "j", ",", 
      RowBox[{"k", "-", "j"}]}], "}"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", 
     RowBox[{"n", "-", "k"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}]], "Input",
