 RowBox[{"likelihood", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{"n", ",", "p"}], "]"}], ",", "k"}], "]"}], 
       RowBox[{"PDF", "[", 
        RowBox[{
