434285787576"],

Cell[TextData[{
 StyleBox["event count",
  FontWeight->"Bold"],
 " is a vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["c", "TI"], "1"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "2"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "3"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "4"]}]], "InlineFormula"], " "}]]}}],
               TraditionalForm]]], ")"}], "\[Element]", 
         SuperscriptBox[
          StyleBox["Z", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
