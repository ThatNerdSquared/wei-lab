Cell[BoxData[
 RowBox[{
  RowBox[{"calculateMatchState", "[", "tetrad_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
    RowBox[{"Equal", ",", " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
         "trimNegs"}], " ", "//", " ", 
        RowBox[{"Map", "[", "First", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
         "trimNegs"}], " ", "//", " ", 
        RowBox[{"Map", "[", "Last", "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
