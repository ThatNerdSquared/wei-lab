Cell["\<\
and a function to calculate the event counts for a given tetrad:\
\>", "Text",
 CellChangeTimes->{{3.992438994293871*^9, 
  3.9924390069290667`*^9}},ExpressionUUID->"840a7bf2-aa91-4426-8802-\
c54fc552e0a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"calculateEventCount", "[", "tetrad_", "]"}], " ", ":=", " ", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
       "Transpose"}], " ", "\[IndentingNewLine]", "//", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Function", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Unequal", " ", "@@@", 
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}]}], 
          "\[IndentingNewLine]", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"True", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"False", " ", "->", "0"}]}], "}"}]}], " ", 
         "\[IndentingNewLine]", "//", " ", "Total"}], "\[IndentingNewLine]", 
        "]"}], "]"}]}], "\[IndentingNewLine]", ")"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"calculateEventCount", "[", "tetrad_", "]"}], " ", ":=", " ", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
      "trimNegs"}], " ", "//", " ", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1"}], "&"}], 
      "]"}]}], " ", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"//", " ", 
      RowBox[{"Map", "[", 
       RowBox[{"Function", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Unequal", " ", "@@@", 
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}]}], 
          "\[IndentingNewLine]", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"True", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"False", " ", "->", "0"}]}], "}"}]}], " ", 
         "\[IndentingNewLine]", "//", " ", "Total"}], "\[IndentingNewLine]", 
        "]"}], "]"}]}], "*)"}], "\[IndentingNewLine]", ")"}]}]}]], "Input",
 CellChangeTimes->{{3.992439010162525*^9, 3.9924390172061253`*^9}, {
