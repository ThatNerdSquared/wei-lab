      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<rEFF/r\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
