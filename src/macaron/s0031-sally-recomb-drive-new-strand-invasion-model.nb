Cell[TextData[{
 "check: for N COs, there should be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["4", 
        StyleBox["N", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "4^N ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "770044e7-06df-4f7d-92c1-22161ba6e461"],
 "possible sequences - test this for N ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|
     "boxes" -> FormBox["\[Element]", TraditionalForm], "errors" -> {}, 
      "input" -> "\\in", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "10"}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "7c4a1195-336a-46ba-8ae3-e36165e6b4bf"],
 ":"
}], "Text",
 CellChangeTimes->{{3.992096491435956*^9, 3.992096493838531*^9}, {
