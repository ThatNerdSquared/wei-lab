     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79788174-71a3-4aa4-a3cb-42052cf63447"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66c6c79a-aa96-43c7-a41f-cce966d20158"],
 " is the number of crossover events the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "th"}], TraditionalForm]],ExpressionUUID->
  "607ef892-de83-4898-b071-e631567f41bc"],
 " chromatid has gone through."
}], "Item",
 CellChangeTimes->{{3.991313303913661*^9, 3.9913133714383783`*^9}, {
   3.991313434109227*^9, 3.991313458470862*^9}, {3.991313493521372*^9, 
   3.991313565352089*^9}, {3.991313725134097*^9, 3.9913137284467707`*^9}, {
   3.991313813980694*^9, 3.991313817381606*^9}, {3.991313855863285*^9, 
   3.991313903320434*^9}, 
   3.9913150881181507`*^9},ExpressionUUID->"0643b259-e389-42a0-922a-\
775fa7f7d41b"],

Cell["\<\
both of these are required to model RF, and neither can be derived from the \
other .\
\>", "Text",
 CellChangeTimes->{{3.991313921336576*^9, 
  3.99131398216849*^9}},ExpressionUUID->"eb8024b6-4d63-4a61-8949-\
7aff291adc71"],

Cell[TextData[{
 "additionally, let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["RF", FontSlant -> "Italic"], "\[Prime]"], TraditionalForm], 
