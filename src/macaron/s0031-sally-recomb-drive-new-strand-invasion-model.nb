Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"expectedrf", "[", "N_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numpossible", " ", "=", " ", 
       RowBox[{
        RowBox[{"4", "^", "N"}], " ", "*", " ", 
        RowBox[{"N", "!"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"leaves", " ", "=", " ", 
       RowBox[{
        RowBox[{"buildCOPairTable", "[", "N", "]"}], "  ", "//", " ", 
        RowBox[{"Map", "[", "tagCOPairs", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"spatords", " ", "=", 
       RowBox[{"leaves", " ", "//", "  ", 
        RowBox[{"Map", "[", "Permutations", "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"totalrf", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tempOrd", " ", "=", " ", 
          RowBox[{"leaves", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"currSpatOrds", " ", "=", " ", 
          RowBox[{"spatords", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"spatOrd", " ", "=", " ", 
              RowBox[{"currSpatOrds", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"tetrad", " ", "=", " ", 
              RowBox[{"placeCOs", "[", 
               RowBox[{"tempOrd", ",", " ", "spatOrd"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"matchState", " ", "=", " ", 
              RowBox[{"calculateMatchState", "[", "tetrad", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"eventCount", " ", "=", " ", 
              RowBox[{"calculateEventCount", "[", "tetrad", "]"}]}], ";"}], 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{"Print", "[", 
              RowBox[{"Sort", "[", "matchState", "]"}], "]"}], "*)"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Print", "[", 
               RowBox[{
                RowBox[{"Sort", "[", "eventCount", "]"}], " ", "//", " ", 
                "Reverse"}], "]"}], ";"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"weightedrf", " ", "=", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"w\[Alpha]", "[", "eventCount", "]"}], " ", "*", " ", 
                
                RowBox[{"getRecombinantState", "[", "matchState", "]"}]}], 
               ")"}], " ", "//", " ", "Total"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"totalrf", " ", "+=", " ", "weightedrf"}], ";"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", 
             RowBox[{"Length", "[", "currSpatOrds", "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "]"}], ";"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "leaves", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"totalrf", " ", "/", " ", "numpossible"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.991514195209303*^9, 3.9915142277724524`*^9}, {
   3.991514298785891*^9, 3.991514366854804*^9}, {3.991514402971962*^9, 
   3.991514457752202*^9}, {3.991514722347115*^9, 3.9915147602940903`*^9}, 
