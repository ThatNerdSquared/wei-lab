Cell[CellGroupData[{

Cell["\<\
placing COs given a temporal and spatial sequence of CO-pairs\
\>", "Subsection",
 CellChangeTimes->{{3.992097526283127*^9, 3.992097527265645*^9}, {
  3.992097616569729*^9, 
  3.992097626457551*^9}},ExpressionUUID->"4ec6f74e-e145-4091-a1c0-\
6ada569dc440"],

Cell["\<\
life will be easier with a function that swaps two items in a list, given a \
list of their indices:\
\>", "Text",
 CellChangeTimes->{{3.992369290079692*^9, 
  3.992369327053742*^9}},ExpressionUUID->"6e5ed6a0-743c-4c82-8e31-\
58cfa6862cad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"swapelems", "[", 
   RowBox[{"list_", ",", " ", "indices_"}], "]"}], " ", ":=", " ", 
  RowBox[{"(*", 
   RowBox[{"If", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"list", "[", 
       RowBox[{"[", 
        RowBox[{"indices", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"list", "[", 
       RowBox[{"[", 
        RowBox[{"indices", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"list", " ", "//", " ", 
       RowBox[{"ReplaceAt", "[", 
        RowBox[{
         RowBox[{"0", "->", "1"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", "#", "}"}], "&"}], "/@", "indices"}]}], "]"}]}], " ", 
      "//", " ", 
      RowBox[{"ReplaceAt", "[", 
       RowBox[{
        RowBox[{"x", "->", 
         RowBox[{"x", "+", "1"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "#", "}"}], "&"}], "/@", "indices"}]}], "]"}]}], 
     ","}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Permute", "[", 
   RowBox[{"list", ",", " ", 
    RowBox[{"Cycles", "[", 
     RowBox[{"{", "indices", "}"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "]", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.992369329370627*^9, 3.992369449541937*^9}, {
  3.992369536890068*^9, 3.992369548983698*^9}, {3.992369616836877*^9, 
  3.992369619120985*^9}, {3.992369794935864*^9, 3.992369799497991*^9}, {
  3.992370350359034*^9, 3.9923704190745573`*^9}, {3.99237052732306*^9, 
  3.9923705438069267`*^9}, {3.99237061147582*^9, 3.992370675630467*^9}, {
  3.992370897245565*^9, 3.992370916775098*^9}, {3.992534002081944*^9, 
  3.9925341310376863`*^9}, {3.9925341877121887`*^9, 3.992534197945608*^9}, {
  3.99253422936522*^9, 3.9925342304905777`*^9}, {3.992534731751655*^9, 
  3.992534737023774*^9}},
 CellLabel->
  "In[155]:=",ExpressionUUID->"9fd06a6e-8036-4fa6-b18d-0977a9e34919"],

