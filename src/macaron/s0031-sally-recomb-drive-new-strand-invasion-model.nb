}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"vec", "[", "n_", "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.993232580080002*^9, 3.993232600031797*^9}},
 CellLabel->
  "In[647]:=",ExpressionUUID->"beccec41-057f-472b-944d-d0e53b60e1ed"],

Cell[BoxData[
 RowBox[{
  RowBox[{"crossovers", "[", "n_", "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"n", "-", "i"}], ",", "j", ",", 
        RowBox[{"n", "-", "j"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
