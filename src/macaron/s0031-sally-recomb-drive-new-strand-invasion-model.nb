Cell["putting it all together:", "Text",
 CellChangeTimes->{{3.9923612190048943`*^9, 
  3.9923612232987013`*^9}},ExpressionUUID->"7cda9ed2-16a0-48f6-b6bc-\
525028b26ccd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"computeNumPops", "[", "spatOrd_", "]"}], " ", ":=", " ", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tags", " ", "=", " ", 
     RowBox[{"extractTags", "[", "spatOrd", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"sublists", " ", "=", " ", 
     RowBox[{"buildReverseAccumulateds", "[", "tags", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"pops", " ", "=", " ", 
     RowBox[{"countTemporalPredecessors", "[", "sublists", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"tags", ",", " ", "pops"}], "}"}], " ", "//", " ", 
        "Transpose"}], " ", "//", " ", 
       RowBox[{"SortBy", "[", "First", "]"}]}], " ", "//", " ", "Transpose"}],
      " ", "//", " ", "Last"}]}], "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.992354216151195*^9, 3.992354218990863*^9}, {
   3.992360076811459*^9, 3.992360100995742*^9}, 3.992360161873123*^9, 
   3.992360362256679*^9, {3.992360679766597*^9, 3.9923606893242903`*^9}, {
   3.992360908526808*^9, 3.992360911131778*^9}, {3.992361085108831*^9, 
   3.992361143050083*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"a39e9ea9-4833-481d-9fc8-12c141dd6797"],

