Cell[BoxData[
 RowBox[{"ReplaceAt", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"x_", ":>", 
    RowBox[{
     RowBox[{"2", " ", "x"}], "-", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", "4", "}"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.992533361141809*^9, 
  3.99253336114354*^9}},ExpressionUUID->"cff5f308-b3d0-4f36-9c1d-\
47c2f43220a3"],

Cell[TextData[{
 "we also need a function that replaces elements at indices other than those \
involved in the CO with ",
 Cell[BoxData[
  RowBox[{"-", "1"}]], "InlineCode",ExpressionUUID->
  "672d4a9e-bd46-4170-8e66-da8d43da7867"],
 ", to indicate that no CO occurred:"
}], "Text",
 CellChangeTimes->{{3.992533151280843*^9, 3.992533175552146*^9}, {
  3.992533601970957*^9, 
  3.992533613967145*^9}},ExpressionUUID->"12fb6b30-1fa3-4e8f-bb9b-\
7d99de6490f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"blankoutelems", "[", 
   RowBox[{"list_", ",", " ", "coPair_"}], "]"}], " ", ":=", " ", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{"list", " ", "//", " ", 
    RowBox[{"ReplaceAt", "[", 
     RowBox[{
      RowBox[{"x_", ":>", " ", 
       RowBox[{"-", "1"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "#", "}"}], "&"}], " ", "/@", " ", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], "}"}], ",",
          " ", "coPair"}], "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.992533181889133*^9, 3.992533195395496*^9}, {
  3.9925333957635183`*^9, 3.9925334037599688`*^9}, {3.992533570483762*^9, 
  3.992533585912939*^9}},
 CellLabel->
  "In[132]:=",ExpressionUUID->"27170079-9728-4523-9931-8b78b3ea05d5"],

