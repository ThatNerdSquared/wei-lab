Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"rr", "=", "1"}], ",", 
   RowBox[{"rr", "\[LessEqual]", "numrec"}], ",", 
   RowBox[{"rr", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"ff", "=", "1"}], ",", 
     RowBox[{"ff", "\[LessEqual]", 
      RowBox[{"Length", "[", "family", "]"}]}], ",", 
     RowBox[{"ff", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"genotype", "[", "ff", "]"}], "=", "origin"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"add", "=", 
       RowBox[{"Last", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"genotype", "[", "ff", "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"switch1", "=", 
       RowBox[{"add", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"family", "[", 
           RowBox[{"[", "ff", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"switch2", "=", 
       RowBox[{"add", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"family", "[", 
           RowBox[{"[", "ff", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"add", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"family", "[", 
           RowBox[{"[", "ff", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "=", "switch2"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"add", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"family", "[", 
           RowBox[{"[", "ff", "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "=", "switch1"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"genotype", "[", "ff", "]"}], "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"genotype", "[", "ff", "]"}], "]"}], ",", 
          RowBox[{"{", "add", "}"}]}], "]"}], "]"}]}]}]}], 
