 CellLabel->
  "In[641]:=",ExpressionUUID->"73510a7c-23b6-456c-a33d-a7cea51bcf18"],

Cell["chromatid 1: 1 CO, looks recombinant (\[OpenCurlyDoubleQuote]unmatched\
\[CloseCurlyDoubleQuote])", "Item",
 CellChangeTimes->{{3.991315520910523*^9, 
  3.99131563493395*^9}},ExpressionUUID->"e21a2fab-43c9-4517-888d-\
bd401b45744d"],

Cell["chromatid 2: 1 CO, looks nonrecombinant (\[OpenCurlyDoubleQuote]matched\
\[CloseCurlyDoubleQuote])", "Item",
 CellChangeTimes->{{3.991315520910523*^9, 
  3.991315633281865*^9}},ExpressionUUID->"215b85be-d0b2-426a-ae1e-\
dc372b6bc35e"],

Cell["chromatid 3: 2 COs, looks recombinant (\[OpenCurlyDoubleQuote]unmatched\
\[CloseCurlyDoubleQuote])", "Item",
 CellChangeTimes->{{3.991315520910523*^9, 
  3.991315683158268*^9}},ExpressionUUID->"fbf29433-e989-4113-a337-\
c39a32457b6c"],

Cell["\<\
so magnitude or parity of the event count can\[CloseCurlyQuote]t be used to \
determine the match state, since the same event count magnitude/parity can be \
found on both matched and unmatched chromatids. 
additionally, match state is required to model RF since it tells us which \
chromatids are visibly recombinant.\
\>", "Text",
 CellChangeTimes->{{3.9913156417298527`*^9, 3.991315711229438*^9}, {
  3.991316167111313*^9, 3.99131616959869*^9}, {3.991316227255249*^9, 
  3.99131623598878*^9}, {3.991316284777323*^9, 
  3.9913163092956877`*^9}},ExpressionUUID->"32b36c97-a9b7-434c-893e-\
140154e3cc66"]
}, Closed]],

Cell[CellGroupData[{

Cell["event count cannot be derived from match state", "Subsection",
 CellChangeTimes->{{3.991314126716464*^9, 
  3.991314138660479*^9}},ExpressionUUID->"4a765b8e-e5b9-48b5-88fb-\
a0ece11a72c8"],

Cell["\<\
as seen above, a single match state can correspond to multiple different \
event counts. so event count can\[CloseCurlyQuote]t be derived from match \
state, either.
additionally, we need event count to be able to weight the chromatids for \
drive (since we assume the actual occurrences of COs are what cause drive, \
not whether a chromatid is unmatched or matched), so we \
can\[CloseCurlyQuote]t just ignore it.\
\>", "Text",
 CellChangeTimes->{{3.991316103639402*^9, 3.991316179651578*^9}, {
  3.991316313622807*^9, 
  3.991316353360262*^9}},ExpressionUUID->"a4719ccd-ad8a-4051-8719-\
bf3b73243de5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SuperscriptBox[
         StyleBox["RF", FontSlant -> "Italic"], "\[Prime]"], "\[Element]", 
        RowBox[{"{", 
          RowBox[{"0", ",", "0.5", ",", "1"}], "}"}]}], TraditionalForm], 
    "errors" -> {}, "input" -> "\\mathit{RF}' \\in \\{ 0, 0.5, 1 \\}", 
    "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], 
  TraditionalForm]],ExpressionUUID->"ef46e11d-7062-4be0-91ef-e8313bee6bf3"]], \
"Subsection",
 CellChangeTimes->{{3.991316247868861*^9, 3.9913162747301483`*^9}, {
   3.991316729053056*^9, 3.991316729485292*^9}, 
   3.991316790134349*^9},ExpressionUUID->"b556e449-1b33-4298-a5c1-\
c4847f5e7b9f"],

Cell["\<\
RF\[CloseCurlyQuote] = 0 to begin with (when no COs have occurred), and all \
chromatids are matched.
then if RF\[CloseCurlyQuote] = 0 and a CO occurs, it involves 2 chromatids \
becoming unmatched, then RF\[CloseCurlyQuote] = 0.5.

then if RF\[CloseCurlyQuote] = 0.5, for the next CO, 2 chromatids either:\
\>", "Text",
 CellChangeTimes->{{3.9913162766489973`*^9, 3.991316277156887*^9}, {
  3.9913163920923862`*^9, 3.991316402629635*^9}, {3.991316442510869*^9, 
  3.99131672109594*^9}, {3.99131679934966*^9, 3.99131680246802*^9}, {
  3.991317129295497*^9, 
  3.991317133681632*^9}},ExpressionUUID->"6f1ad6db-59ee-4836-a39e-\
482f62d4e334"],

Cell["remain as matched and unmatched  => RF\[CloseCurlyQuote] stays at 0.5", \
"Item",
 CellChangeTimes->{{3.9913170807847013`*^9, 
  3.991317086805849*^9}},ExpressionUUID->"a1384353-55bd-4274-8fb1-\
409c47d7748b"],

Cell["both become matched => RF\[CloseCurlyQuote] = 0", "Item",
 CellChangeTimes->{{3.9913170807847013`*^9, 
  3.991317089921445*^9}},ExpressionUUID->"7656e59e-093c-4aa4-aec5-\
f6f27fd9b745"],

Cell["both become unmatched => RF\[CloseCurlyQuote] = 1.", "Item",
 CellChangeTimes->{{3.9913170807847013`*^9, 
  3.991317100948353*^9}},ExpressionUUID->"1a2db597-4017-4e82-9703-\
860d33e17d70"],

Cell["\<\
then if RF\[CloseCurlyQuote] = 1, any future CO re-matches 2 chromatids, so \
RF\[CloseCurlyQuote] = 0.5.\
\>", "Text",
 CellChangeTimes->{
  3.991317102749694*^9},ExpressionUUID->"5cb570f3-ea8f-4449-9b0f-\
607e95a76d5c"],

Cell[TextData[{
 "so ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["RF", FontSlant -> "Italic"], "\[Prime]"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"0", ",", "0.5", ",", "1"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathit{RF}' \\in \\{ 0, 0.5, 1 \\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8419cfa-c63d-4820-a579-60f72b0d88b3"],
 ". since every CO involves exactly 2 chromatids, no other values for RF\
\[CloseCurlyQuote] can be obtained."
}], "Text",
 CellChangeTimes->{{3.991317106347279*^9, 
  3.99131711978941*^9}},ExpressionUUID->"963d3acf-2e96-4939-8f80-\
3251ad3b3093"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
match state is dependent on CO-pair temporal ordering (and possibly spatial \
ordering too)\
\>", "Subsection",
 CellChangeTimes->{{3.991314167980858*^9, 3.991314171003459*^9}, {
  3.9913143764532137`*^9, 3.991314414390127*^9}, {3.991317274951165*^9, 
  3.991317275962637*^9}},ExpressionUUID->"7876ec5a-8a01-49c9-8052-\
77a27827a6a8"],

Cell["\<\
we start with a 0-CO chromatid: it is in match state (1, 1, 1, 1). then \
consider the set of COs {13, 23, 24}.\
\>", "Text",
 CellChangeTimes->{{3.991317277414311*^9, 3.991317312867564*^9}, {
  3.9913174949336348`*^9, 3.9913175069721193`*^9}, {3.991323144998814*^9, 
  3.991323146399424*^9}},ExpressionUUID->"f92fe597-013d-414b-b090-\
25518e27ef94"],

Cell["case 1: [13, 23, 24]:", "Text",
 CellChangeTimes->{{3.9913173187509947`*^9, 
  3.9913173304327593`*^9}},ExpressionUUID->"356514a7-7357-43b1-b34b-\
2797645a4328"],

Cell["13 => (0, 1, 0, 1)", "Item",
 CellChangeTimes->{{3.991317341202311*^9, 3.991317347943201*^9}, {
  3.991323153181437*^9, 
  3.991323154463148*^9}},ExpressionUUID->"4b1bc0fa-899d-4045-86fd-\
76ee22b47881"],

Cell["23 => (0, 1, 0, 1)", "Item",
 CellChangeTimes->{{3.991317341202311*^9, 3.991317356455357*^9}, {
  3.991323158135007*^9, 
  3.991323159278747*^9}},ExpressionUUID->"a315bd07-b409-454e-8937-\
0aaddd4aec3a"],

Cell["24 => (0, 0, 0, 0)", "Item",
 CellChangeTimes->{{3.991317341202311*^9, 3.9913173611473923`*^9}, 
   3.991317473107212*^9, {3.991323162612117*^9, 
   3.9913231643810453`*^9}},ExpressionUUID->"034a1771-9401-4375-b81e-\
f756b76bd4b5"],

Cell["which gives an RF\[CloseCurlyQuote] of 1.", "Text",
 CellChangeTimes->{{3.991317475243101*^9, 
  3.991317478156486*^9}},ExpressionUUID->"446b46e1-b91a-4408-bd78-\
d88e2b97b169"],

Cell["case 2: [23, 13, 24]:", "Text",
 CellChangeTimes->{{3.991317366490183*^9, 
  3.99131738172151*^9}},ExpressionUUID->"e5f2ec78-9110-4347-b9f3-\
34d235c81344"],

Cell["23 => (1, 0, 0, 1)", "Item",
 CellChangeTimes->{{3.991317392045239*^9, 3.9913173956168756`*^9}, {
  3.991323175195335*^9, 
  3.991323176626101*^9}},ExpressionUUID->"6ba41a27-be85-49db-91c7-\
822c5a9ea220"],

Cell["13 => (1, 0, 0, 1)", "Item",
 CellChangeTimes->{{3.991317392045239*^9, 3.991317403567339*^9}, {
  3.991323180798711*^9, 
  3.991323182969266*^9}},ExpressionUUID->"921bc7ff-cad9-4eea-84a6-\
f3e7880ba595"],

Cell["24 => (1, 0, 0, 1)", "Item",
 CellChangeTimes->{{3.991317392045239*^9, 3.991317409335538*^9}, {
  3.991323189445737*^9, 
  3.9913231953936853`*^9}},ExpressionUUID->"28ec7637-cc33-4fb8-b1ba-\
c9289266fc08"],

Cell["which gives an RF\[CloseCurlyQuote] of 0.5.", "Text",
 CellChangeTimes->{{3.991317413765171*^9, 
  3.991317418646337*^9}},ExpressionUUID->"3067b385-674f-4e94-8c32-\
e64e355d6a1f"],

Cell["\<\
so the resulting match state from a set of CO-pairs is dependent on which \
CO-pair comes first, and this is important because it can result in different \
RF\[CloseCurlyQuote] values, which could give different RFs down the line.\
\>", "Text",
 CellChangeTimes->{{3.99131742081901*^9, 
  3.991317468307415*^9}},ExpressionUUID->"b9b7215b-134d-4918-9b0a-\
711e962998fb"],

Cell["\<\
additionally, the example above assumes that both markers are on the same \
side of the centromere (i.e., one marker never \[OpenCurlyDoubleQuote]moves\
\[CloseCurlyDoubleQuote], and only the more distal marker is \
\[OpenCurlyDoubleQuote]recombined away\[CloseCurlyDoubleQuote]). in a \
situation where the markers are on either side of the centromere, the spatial \
ordering matters as well:\
\>", "Text",
 CellChangeTimes->{{3.9913178855720882`*^9, 3.991317954014442*^9}, {
  3.991318050930003*^9, 
  3.991318054416114*^9}},ExpressionUUID->"d9d8acbf-c912-45e8-a093-\
f20a0bbee9c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", "--"}], "-", 
  RowBox[{".", 
   RowBox[{"--", 
    RowBox[{"-", "\n", 
     RowBox[{"2", " ", "--"}]}]}]}], "-", 
  RowBox[{
   RowBox[{".", 
    RowBox[{"--", 
     RowBox[{"-", "\n", "3"}]}]}], " ", 
   RowBox[{"xxx", ".", "xxx"}]}]}], "\n", 
 RowBox[{"4", " ", 
  RowBox[{"xxx", ".", "xxx"}]}]}], "Code",
 CellChangeTimes->{{3.9913179971838093`*^9, 3.991317997883937*^9}, {
  3.991318040892539*^9, 3.991318048603623*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"948c63e1-a4ce-4ecc-87de-c0fcb66e7dfc"],

Cell["then insert a 13 CO:", "Text",
 CellChangeTimes->{{3.9913180560600643`*^9, 
  3.9913180654189777`*^9}},ExpressionUUID->"3f46220f-9b52-45ca-82da-\
4f6120279498"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"1", " ", "--"}], "-", 
   RowBox[{".", "-"}]}], "|", "xx"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", "--"}], "-", 
   RowBox[{
    RowBox[{".", 
     RowBox[{"--", 
      RowBox[{"-", "\n", "3"}]}]}], " ", 
    RowBox[{"xxx", ".", "x"}]}]}], "|", 
  RowBox[{
   RowBox[{"--", "\n", "4"}], " ", 
   RowBox[{"xxx", ".", "xxx"}]}]}]}], "Code",
 CellChangeTimes->{{3.991318067111512*^9, 3.99131809042393*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"a72b21e2-3770-42b1-892c-cd24eba737b6"],

Cell["\<\
then we can insert a 23 CO either to the left or right of the centromere.
if on the left:\
\>", "Text",
 CellChangeTimes->{{3.9913182251460114`*^9, 
  3.991318255923746*^9}},ExpressionUUID->"044cc603-e3f1-4f84-a394-\
4c9a74572f1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"1", " ", "--"}], "-", 
   RowBox[{".", "-"}]}], "|", "xx"}], "\n", 
 RowBox[{
  RowBox[{"2", " ", "x"}], "|", 
  RowBox[{
   RowBox[{"--", 
    RowBox[{".", 
     RowBox[{"--", 
      RowBox[{"-", "\n", "3"}]}]}]}], " ", "-"}], "|", 
  RowBox[{"xx", ".", "x"}], "|", 
  RowBox[{
   RowBox[{"--", "\n", "4"}], " ", 
   RowBox[{"xxx", ".", "xxx"}]}]}]}], "Code",
 CellChangeTimes->{{3.991318259186186*^9, 3.991318266787518*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"f478a9a9-b22e-4262-a709-ba97aa935e39"],

Cell["\<\
this gives us a match state of (0, 0, 1, 1).
if on the right:\
\>", "Text",
 CellChangeTimes->{{3.991318267891349*^9, 
  3.991318286476901*^9}},ExpressionUUID->"07bbddf8-4fbf-47a5-8b2b-\
4d3d4e3e2236"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"1", " ", "--"}], "-", 
   RowBox[{".", "-"}]}], "|", "xx"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", "--"}], "-", 
   RowBox[{".", "--"}]}], "|", 
  RowBox[{
   RowBox[{"-", "\n", "3"}], " ", 
   RowBox[{"xxx", ".", "x"}]}], "|", 
  RowBox[{"-", 
   RowBox[{"|", 
    RowBox[{
     RowBox[{"-", "\n", "4"}], " ", 
     RowBox[{"xxx", ".", "xxx"}]}]}]}]}]}], "Code",
 CellChangeTimes->{{3.99131828824023*^9, 3.991318297587337*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"c66114c9-2346-488e-84e9-dba7d5740d05"],

Cell["this gives us a match state of (0, 1, 0, 1).", "Text",
 CellChangeTimes->{{3.991318301974567*^9, 3.99131831102596*^9}, 
   3.9913183627925053`*^9, 
   3.991318545688715*^9},ExpressionUUID->"0ffd6b50-c4a4-4de3-90dd-\
22101ba305b5"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
event count is dependent on CO-pair spatial ordering (but not temporal)\
\>", "Subsection",
 CellChangeTimes->{{3.9913144028207903`*^9, 
  3.991314422658935*^9}},ExpressionUUID->"d51332a4-f0cd-4f49-a049-\
e82948472727"],

Cell["consider the CO sequence [13, 23]:", "Text",
 CellChangeTimes->{{3.991314001937302*^9, 3.99131400530652*^9}, {
   3.9913151466068993`*^9, 3.991315163652214*^9}, {3.991315779866845*^9, 
   3.9913157924663553`*^9}, 3.991315992616794*^9, 3.9913160802392187`*^9, {
   3.991318909372574*^9, 
   3.9913189160959167`*^9}},ExpressionUUID->"ad345619-0901-4da5-bbea-\
1197469ec562"],

Cell["first crossover: 13:", "Text",
 CellChangeTimes->{{3.9905595760209084`*^9, 3.990559595131379*^9}, 
   3.99131893004275*^9},ExpressionUUID->"886ebdad-3e24-45de-9afa-\
2e2cf0076b62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", ".", 
   RowBox[{"--", "-"}]}], "|", "xxx"}], "\n", 
 RowBox[{
  RowBox[{"2", " ", ".", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", "\n", "3"}]}]}], " ", ".", "xxx"}], "|", 
  RowBox[{"--", 
   RowBox[{"-", "\[IndentingNewLine]", 
    RowBox[{"4", " ", ".", "xxxxxx"}]}]}]}]}], "Code",
 CellChangeTimes->{{3.990559598489345*^9, 3.9905596185741158`*^9}, {
  3.9905622238462677`*^9, 3.990562228201544*^9}, {3.990623424036379*^9, 
  3.990623463731576*^9}, {3.9913154723409986`*^9, 3.991315507835512*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"5512fcab-b767-4838-91cc-e8d47208cde1"],

Cell["\<\
for the second crossover 23, we can either place this CO left or right of the \
previous CO.
if right:\
\>", "Text",
 CellChangeTimes->{{3.990559620230195*^9, 3.990559628828438*^9}, {
  3.991318923963196*^9, 
  3.991318964706902*^9}},ExpressionUUID->"1c1d09e4-dee2-4f33-9f83-\
0ba9cac5cc03"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", ".", 
   RowBox[{"--", "-"}]}], "|", "xxx"}], "\n", 
 RowBox[{
  RowBox[{"2", " ", ".", 
   RowBox[{"--", "--"}]}], "|", 
  RowBox[{
   RowBox[{"--", "\n", "3"}], " ", ".", "xxx"}], "|", 
  RowBox[{"-", 
   RowBox[{"|", 
    RowBox[{"--", "\[IndentingNewLine]", 
     RowBox[{"4", " ", ".", "xxxxxx"}]}]}]}]}]}], "Code",
 CellChangeTimes->{{3.9905596311964808`*^9, 3.990559662666089*^9}, {
  3.990562231099587*^9, 3.990562233914229*^9}, {3.9906234319945507`*^9, 
  3.990623473969702*^9}, {3.9913155127331743`*^9, 3.991315518792543*^9}, {
  3.991318099062872*^9, 3.99131811679321*^9}, {3.991318207127174*^9, 
  3.9913182082437267`*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"8662d271-1ec0-46c2-b5ee-5d59e94ab185"],

Cell["\<\
this gives us an event count of (1, 1, 2, 0).
if left:\
\>", "Text",
 CellChangeTimes->{{3.991318966318256*^9, 3.9913189792996273`*^9}, {
  3.991319009630557*^9, 
  3.991319010116625*^9}},ExpressionUUID->"7d7deaec-c930-42bd-bc95-\
69919e4b22b9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", ".", 
   RowBox[{"--", "-"}]}], "|", "xxx"}], "\n", 
 RowBox[{
  RowBox[{"2", " ", ".", "--"}], "|", "x", "|", 
  RowBox[{"--", 
   RowBox[{"-", "\n", 
    RowBox[{"3", " ", ".", "xx"}]}]}], "|", 
  RowBox[{
   RowBox[{"--", 
    RowBox[{"--", "\[IndentingNewLine]", "4"}]}], " ", ".", 
   "xxxxxx"}]}]}], "Code",
 CellChangeTimes->{{3.991318980831933*^9, 3.9913189926637087`*^9}},
 CellLabel->
  "In[641]:=",ExpressionUUID->"b4956d7d-4d34-4a9f-9bfb-3afa9d71ed45"],

Cell["\<\
this gives us an event count of (1, 2, 1, 0).
so the event count is dependent on where the COs are placed, although not the \
order they are placed in.\
\>", "Text",
 CellChangeTimes->{{3.99131886476408*^9, 3.9913188661423807`*^9}, {
  3.991318994784809*^9, 
  3.991319038886565*^9}},ExpressionUUID->"b8e30d4e-47fd-426f-af99-\
73eb374c3168"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["RF model components", "Section",
 CellChangeTimes->{{3.991313291977355*^9, 3.991313303092656*^9}, 
   3.991313979966653*^9, {3.991314663171487*^9, 3.9913146748851423`*^9}, {
   3.991315941946102*^9, 
   3.991315943928445*^9}},ExpressionUUID->"20317e6b-3aa7-4568-9241-\
6884d4a4c49f"],

Cell["\<\
we first list all possible chromatid pairs that can participate in a CO:\
\>", "Text",
 CellChangeTimes->{{3.9920224974328537`*^9, 
  3.992022511414736*^9}},ExpressionUUID->"8b46d5bb-5a85-4366-aaed-\
7694f77cf427"],

Cell[BoxData[
 RowBox[{
  RowBox[{"possiblepairs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.992022513303731*^9, {3.9920232187351513`*^9, 3.992023219381012*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"2b404649-ac93-4a7f-8c8b-78c72af20fcc"],

Cell[CellGroupData[{

Cell["weights from drive", "Subsection",
 CellChangeTimes->{{3.99131468065956*^9, 3.9913147117439632`*^9}, {
  3.991325317563283*^9, 
  3.991325318846671*^9}},ExpressionUUID->"d86dfcc4-97ea-44f2-a6ce-\
1a9c3a04f6f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"w\[Alpha]", "[", "x_", "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"1", "+", " ", 
     RowBox[{"x", "*", "\[Alpha]"}]}], 
    RowBox[{"Total", "[", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"x", "*", "\[Alpha]"}]}], "]"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.991500708401581*^9, 3.991500709063546*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"edc404d4-2e5d-48fb-90ec-9f847f789302"]
}, Open  ]],

Cell[CellGroupData[{

Cell["generating all possible CO-pair sequences of length N", "Subsection",
 CellChangeTimes->{{3.9920222949533443`*^9, 
  3.992022317541313*^9}},ExpressionUUID->"7e0dc8ad-5bd2-4f8d-8711-\
2ffb44edb350"],

Cell["\<\
create a function that attaches a given chromatid pair to each of a list of \
decision tree \[OpenCurlyDoubleQuote]branches\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.992025384515862*^9, 3.99202541017214*^9}, {
  3.992097672443571*^9, 
  3.992097699981142*^9}},ExpressionUUID->"ea9ef206-fe92-4d48-960f-\
62371d0e0248"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildBranch", "[", 
   RowBox[{"pair_", ",", "branches_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "pair", "}"}], ",", " ", "#"}], "]"}], "&"}], " ", " ", "/@",
    " ", "branches"}]}]], "Input",
 CellChangeTimes->{{3.992025418512841*^9, 3.992025527143056*^9}, {
   3.992091420686508*^9, 3.9920914228485003`*^9}, {3.992092864219198*^9, 
   3.992092865603374*^9}, {3.9920931443721247`*^9, 3.992093147310836*^9}, {
   3.992093357922523*^9, 3.9920933645973043`*^9}, {3.992094677862221*^9, 
   3.9920946850556107`*^9}, {3.9920955332798357`*^9, 3.992095549752468*^9}, {
   3.992095658245652*^9, 3.9920956695445004`*^9}, 3.992096209870091*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"49a96e5f-54bb-414b-a477-f8e42d1b741f"],

Cell["\<\
then for a given N COs, we recursively generate all possible chromatid pair \
sequences of length N:\
\>", "Text",
 CellChangeTimes->{{3.9920223205791187`*^9, 3.992022325411367*^9}, {
  3.992095610665395*^9, 3.9920956467975893`*^9}, {3.992096227279106*^9, 
  3.992096230680512*^9}, {3.992096398565515*^9, 
  3.99209642895055*^9}},ExpressionUUID->"8e1897ee-d223-4c66-9967-\
e8928a4afdca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildCOPairTable", "[", "N_", "]"}], " ", ":=", " ", 
  RowBox[{"If", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "==", "0"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"{", "}"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"buildBranch", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"buildCOPairTable", "[", 
          RowBox[{"N", "-", "1"}], "]"}]}], "]"}], "&"}], " ", "/@", " ", 
      "possiblepairs"}], "\[IndentingNewLine]", "//", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "flatten", " ", "the", " ", "4", " ", "sublists", " ", "created"}], ",", 
     " ", 
     RowBox[{"1", " ", "per", " ", "pair"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->CompressedData["
1:eJwdy1soQwEAh/GZcjnZkmE0llsTNUdoGHMrD5LLJiUpWbaG1iJHJ1NevFGE
FktIM01ZtFwLIx6We6a8yGoPLrm0WnJZzfmfh6/f05eqNqg0XA6Hk8wEtRc/
VunBe+WqO8sGx75JJ+SJFKwj50o3lG70vUDhXSY/h3Fr0hgHzRaxHoolKgO0
