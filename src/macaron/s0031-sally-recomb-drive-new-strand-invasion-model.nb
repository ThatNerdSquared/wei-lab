Cell[CellGroupData[{

Cell["\<\
determining how many COs need to be \[OpenCurlyDoubleQuote]moved off\
\[CloseCurlyDoubleQuote] when a new one is placed\
\>", "Subsection",
 CellChangeTimes->{{3.9923619448953238`*^9, 
  3.992361958323803*^9}},ExpressionUUID->"ffe947e0-28cf-457f-9ce7-\
f72b6931077f"],

Cell[TextData[{
 "given a CO ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fdd0447b-f3e0-4822-9a63-b2688850184b"],
 ", some other COs may be spatially later but temporally earlier, and these \
COs will need to be \[OpenCurlyDoubleQuote]moved off\[CloseCurlyDoubleQuote] \
the chromosome when we place ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d519f14-3bd4-4931-8347-efcb9b580e2d"],
 ". to do this, we need to \[OpenCurlyDoubleQuote]tag\[CloseCurlyDoubleQuote] \
each CO-pair in the temporal order to distinguish, e.g. two ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", "3"}], "}"}]], "InlineCode",ExpressionUUID->
  "a91bf150-6e32-4e19-9b5b-1104ca175311"],
 " CO-pairs when they get shuffled in the spatial order:"
}], "Text",
 CellChangeTimes->{{3.9923519150007687`*^9, 3.992352090098106*^9}, 
   3.9923524420210953`*^9, {3.992353100995049*^9, 
   3.992353134131379*^9}},ExpressionUUID->"b30b8b25-fac1-4422-a142-\
21ba547831c7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tagCOPairs", "[", "pairs_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pairs", ",", " ", 
     RowBox[{
      RowBox[{"Length", "[", "pairs", "]"}], " ", "//", " ", "Range"}]}], 
    "}"}], " ", "//", " ", "Transpose"}]}]], "Input",
 CellChangeTimes->{{3.99235186401373*^9, 3.992351883422482*^9}, 
   3.992352449634059*^9},
 CellLabel->"In[11]:=",ExpressionUUID->"4cf9ecd3-e384-4eb6-bcf4-069a588bc7a2"],

