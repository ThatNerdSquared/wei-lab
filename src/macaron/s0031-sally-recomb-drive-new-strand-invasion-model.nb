2a1819556e2c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expectedlens", " ", "=", " ", 
   RowBox[{
    RowBox[{"4", "^", "x"}], " ", "/.", 
    RowBox[{"x", "->", 
     RowBox[{"Range", "[", "n", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actuallens", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Range", "[", "n", "]"}], " ", "//", " ", 
     RowBox[{
      RowBox[{"buildCOPairTable", " ", "/@", " ", "#"}], "&"}]}], " ", "//", 
    RowBox[{
     RowBox[{"Length", " ", "/@", "#"}], "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expectedlens", "==", "actuallens"}]}], "Input",
