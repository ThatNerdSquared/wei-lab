       RowBox[{
        RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
        "First"}], ",", " ", 
       RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}]}], "}"}], "*)"}], 
    "\[IndentingNewLine]", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
