     RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF2", "/", "r"}], ",", 
