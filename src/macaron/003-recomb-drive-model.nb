Cell[CellGroupData[{

Cell[TextData[StyleBox["multiplicative \[Alpha]", "Subsubsection"]], \
"Subsubsection",
 CellChangeTimes->{{3.993735420158743*^9, 3.993735427050846*^9}, {
  3.993918848833696*^9, 3.9939188490366917`*^9}, {3.9957285315329447`*^9, 
  3.995728532258132*^9}, {3.995728580758862*^9, 
  3.995728581014338*^9}},ExpressionUUID->"95a6cc52-c2b6-45be-a981-\
04d03adb4474"],

Cell["\<\
we define a function that additively weights the number of COs per chromatid \
by \[Alpha], and then multiplies that by 1 if the chromatid is recombinant \
(and 0 otherwise):\
\>", "Text",
 CellChangeTimes->{{3.993648821865613*^9, 3.993648824328911*^9}, {
  3.993649047883813*^9, 
  3.99364910526503*^9}},ExpressionUUID->"c0939783-6bd3-475a-a580-\
1abd52880ea9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w\[Alpha]Mult", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}], "y"], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", "\[Alpha]"}], ")"}], "y"], "[", 
       RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]], " ", "*",
    " ", 
   RowBox[{"Mod", "[", 
    RowBox[{"y", ",", " ", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.993575416953635*^9, 3.9935754773775787`*^9}, {
  3.993575716864176*^9, 3.993575721902451*^9}, {3.9935815972019243`*^9, 
  3.9935816211676617`*^9}, {3.993649063416144*^9, 3.993649067023843*^9}, {
  3.993735461328712*^9, 3.993735470530177*^9}, {3.993735846444206*^9, 
  3.993735871321988*^9}, {3.993749851040848*^9, 3.993749870648551*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"e0079916-49cf-401c-9398-13bd31db8112"],

Cell["\<\
and then we define a function that sums the application of this function \
across all chromatids:\
\>", "Text",
 CellChangeTimes->{{3.993654827980854*^9, 
  3.9936548424962673`*^9}},ExpressionUUID->"5795cb4f-97f6-41d0-9899-\
4ea18814d012"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"w\[Alpha]Mult", "[", "y", "]"}], " ", "//", " ", 
   "Total"}]}]], "Input",
 CellChangeTimes->{{3.993574997467475*^9, 3.9935750149674397`*^9}, {
  3.9936548702379093`*^9, 3.993654873494124*^9}, {3.993735879664751*^9, 
  3.993735879988345*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"b928abf8-7c28-4f58-950d-05e0a81c4137"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["m", "TI"], "mult"], TraditionalForm], "errors" -> {}, 
     "input" -> "m_{\\text{mult}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "127652d6-19b4-4909-8191-a956a1130ab6"],
 " is a random variable representing the proportion of recovered chromatids \
that are recombinant:"
}], "Text",
 CellChangeTimes->{{3.9937358950506783`*^9, 3.9937359145168467`*^9}, {
  3.993918994170825*^9, 
  3.993918997650495*^9}},ExpressionUUID->"ed620fec-13ab-4f65-8180-\
