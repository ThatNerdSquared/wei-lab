Cell[CellGroupData[{

Cell["With two crossovers", "Subsubsection",
 CellChangeTimes->{{3.991326567260683*^9, 
  3.9913265798943243`*^9}},ExpressionUUID->"a0f0d197-ba10-4680-a066-\
1dce237bd79a"],

Cell["With exactly two crossover events, the chromatid states are:", "Text",
 CellChangeTimes->{{3.9913253734242*^9, 3.9913253858957977`*^9}, {
  3.991327391655076*^9, 
  3.991327394603837*^9}},ExpressionUUID->"b8626359-2063-4b56-a601-\
10654ab10a75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabEVENTS", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "crossover", " ", "events", " ", "between", " ", 
    "the", " ", "ends"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabMATCHES", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Whether", " ", "markers", " ", "match", " ", "at", " ", "the", " ", 
    "ends", " ", 
    RowBox[{"(", 
     RowBox[{"0", "=", "no"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"tabCOUNTS", "/", 
    RowBox[{"Total", "[", "tabCOUNTS", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991325321537078*^9, 3.991325445634583*^9}, {
  3.991326682392687*^9, 3.991326784415893*^9}, {3.9913268427012167`*^9, 
  3.991326853518496*^9}, {3.991326892026586*^9, 3.9913269183883133`*^9}},
 CellLabel->
  "In[143]:=",ExpressionUUID->"09818c2c-facb-4014-9344-82f4e6990b43"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ii", "=", "1"}], ";", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"{", "}"}]}]}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tabBIAS", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
       RowBox[{
        RowBox[{"tabEVENTS", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
        RowBox[{
         RowBox[{"tabEVENTS", "[", 
          RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], "]"}]]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"temp", "=", 
     RowBox[{
      RowBox[{"tabBIAS", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
         RowBox[{"tabMATCHES", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}], "//", "Total"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"rEFFTAB", ",", 
       RowBox[{"r2", "*", "temp"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.991326936738636*^9, 3.9913270292006807`*^9}, {
  3.991327125717301*^9, 3.991327129528275*^9}, {3.9913273421960707`*^9, 
  3.991327346612061*^9}},
 CellLabel->
  "In[157]:=",ExpressionUUID->"4459957c-3828-429e-a031-0151560f6b8a"],

Cell[BoxData[
 RowBox[{"rEFFTAB", "//", "Factor"}]], "Input",ExpressionUUID->"a64c7058-229c-480d-8709-f9f77d2144f1"],

Cell["\<\
Check, but with two crossover events, the average number of matches is 1/2 \
(in the absence of bias):\
\>", "Text",
 CellChangeTimes->{{3.9913277031649027`*^9, 
  3.991327739561007*^9}},ExpressionUUID->"fa2e46d4-4733-4587-8844-\
cef0356b3daf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "[", 
      RowBox[{"[", "i", "]"}], "]"}], 
     RowBox[{"Mean", "[", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
        RowBox[{"tabMATCHES", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], "}"}]}], "]"}], "//", 
  "Total"}]], "Input",
 CellChangeTimes->{{3.9913274948538218`*^9, 3.991327650325799*^9}, {
  3.9913276998089314`*^9, 3.991327700723856*^9}},
 CellLabel->
  "In[170]:=",ExpressionUUID->"c734ba6b-4bf5-4e4e-a0a2-a53b84eef7d7"],

Cell[BoxData[
 FractionBox["1", "2"]], "Output",
 CellChangeTimes->{{3.991327497619615*^9, 3.991327524713953*^9}, {
   3.9913275845727043`*^9, 3.9913276185804996`*^9}, 3.991327652720624*^9, 
   3.9913277012841873`*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"03055ec1-24d5-4b8f-afc5-fa3a20f96cc2"]
}, Open  ]],

Cell["\<\
where r2 is some function relating the recombination rate r to the chance of \
two recombination events. 
For example, if there were only 0 or two recombination events (never one), \
then the average observed recombination rate between markers (no bias) would \
be p0*0+p2*1/2. Setting p2=1-p0, we would have to have p2 = 2 r (just like \
with one crossover) to have an average recombination rate in the region of r.\
\
\>", "Text",
 CellChangeTimes->{{3.991327399958219*^9, 3.99132747980583*^9}, {
  3.991327805048751*^9, 
  3.9913279319445868`*^9}},ExpressionUUID->"be2adbac-c08c-41b3-b8b1-\
7ad49a96651f"],

Cell["\<\
If there was a 2r chance of 2 crossovers (so that each chromatid has a chance \
of r of having the markers not match) and otherwise no recombination events, \
then bias will change this by an amount:\
\>", "Text",
 CellChangeTimes->{{3.9913255906041403`*^9, 3.991325644618166*^9}, {
  3.991326173971485*^9, 3.991326179124524*^9}, {3.991328064583829*^9, 
  3.991328087444222*^9}},ExpressionUUID->"f8bf448f-dee9-428c-b1fe-\
85b11640f80e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEFF2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "*", "rEFFTAB"}], "/.", 
     RowBox[{"r2", "->", 
      RowBox[{"2", " ", "r"}]}]}], "//", "Total"}], "//", 
   "Factor"}]}]], "Input",
 CellChangeTimes->{{3.991327363048202*^9, 3.991327383811064*^9}, {
  3.991327982222476*^9, 3.991328011326496*^9}, {3.991328045703308*^9, 
  3.99132804726472*^9}, {3.991328218605659*^9, 3.9913282199647923`*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"37472a64-7ff7-429a-9063-9408966a9e84"],

Cell[BoxData[
 FractionBox[
  RowBox[{"r", " ", 
   RowBox[{"(", 
    RowBox[{"4", "+", 
     RowBox[{"5", " ", "\[Alpha]"}]}], ")"}]}], 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]], "Output",
 CellChangeTimes->{
  3.9913271365405273`*^9, {3.991327348820251*^9, 3.991327384272263*^9}, {
   3.991327990974868*^9, 3.99132801575552*^9}, 3.991328049218848*^9, 
   3.991328094690332*^9, 3.9913282209357777`*^9},
 CellLabel->
  "Out[177]=",ExpressionUUID->"cd4c6671-a642-4370-b228-7c1ab0d0c47e"]
}, Open  ]],

Cell["In the absence of a bias:", "Text",
 CellChangeTimes->{{3.9913257819296*^9, 
  3.9913257900935373`*^9}},ExpressionUUID->"d48448a5-5f93-46e4-9925-\
bad10ace775c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", "/.", 
  RowBox[{"\[Alpha]", "->", "0"}]}]], "Input",
 CellChangeTimes->{{3.991325792337768*^9, 3.99132579592723*^9}},
 CellLabel->
  "In[176]:=",ExpressionUUID->"bc816b88-7c7f-477e-8831-f94a342772e8"],

Cell[BoxData["r"], "Output",
 CellChangeTimes->{3.9913257966346817`*^9, 3.991325884950636*^9, 
  3.9913261449154663`*^9, 3.991328102240513*^9},
 CellLabel->
  "Out[176]=",ExpressionUUID->"c254e318-89b1-48c3-b577-dffe24c404f8"]
}, Open  ]],

Cell["\<\
In the limit, as \[Alpha] goes to infinity, then the max rEFF would be 5r/4, \
which will rise above one for r values >0.8.  This (dashed) is much less \
biased than with a single cross-over (solid black), even though we have \
allowed an additive rise in preference with the number of crossover events.\
\>", "Text",
 CellChangeTimes->{{3.991326257484338*^9, 3.9913262770593643`*^9}, {
  3.991326327501597*^9, 3.9913263502272367`*^9}, {3.9913281197471743`*^9, 
  3.99132817083109*^9}, {3.991328283370219*^9, 
  3.991328292092347*^9}},ExpressionUUID->"12ed683e-34ac-4a0a-86b5-\
f21c675fffe0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF2", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<rEFF/r\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9913261832988853`*^9, 3.991326198875721*^9}, {
