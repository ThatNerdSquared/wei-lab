Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", "r", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.991326142426478*^9, 3.991326237453845*^9},
 CellLabel->
  "Out[127]=",ExpressionUUID->"79eeb304-bf3e-4771-895f-f4073b810e5b"]
}, Open  ]],

