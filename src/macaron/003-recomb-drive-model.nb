  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF2", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<rEFF/r\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9913261832988853`*^9, 3.991326198875721*^9}, {
  3.991326242480937*^9, 3.991326247636138*^9}, {3.991328231350379*^9, 
