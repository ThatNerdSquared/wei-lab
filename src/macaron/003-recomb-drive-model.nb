   3.992369531757812*^9, 3.992370426928541*^9, {3.992370924106885*^9, 
   3.9923709258050756`*^9}, {3.992389053910022*^9, 3.992389056996888*^9}},
 CellLabel->
  "In[251]:=",ExpressionUUID->"eb2e9ef0-b057-4873-b563-367a3747d78c"],

