Cell["With exactly two crossover events, the chromatid states are:", "Text",
 CellChangeTimes->{{3.9913253734242*^9, 3.9913253858957977`*^9}, {
  3.991327391655076*^9, 
  3.991327394603837*^9}},ExpressionUUID->"6c3d2e5a-1875-4841-a275-\
91c6522caa88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabEVENTS", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "crossover", " ", "events", " ", "between", " ", 
    "the", " ", "ends"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabMATCHES", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Whether", " ", "markers", " ", "match", " ", "at", " ", "the", " ", 
    "ends", " ", 
    RowBox[{"(", 
     RowBox[{"0", "=", "no"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"tabCOUNTS", "/", 
    RowBox[{"Total", "[", "tabCOUNTS", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991325321537078*^9, 3.991325445634583*^9}, {
  3.991326682392687*^9, 3.991326784415893*^9}, {3.9913268427012167`*^9, 
  3.991326853518496*^9}, {3.991326892026586*^9, 3.9913269183883133`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"ea1736b0-390e-4656-880c-ebd03448dd0f"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ii", "=", "1"}], ";", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"{", "}"}]}]}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tabBIAS", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
       RowBox[{
        RowBox[{"tabEVENTS", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
        RowBox[{
         RowBox[{"tabEVENTS", "[", 
          RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], "]"}]]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"temp", "=", 
     RowBox[{
      RowBox[{"tabBIAS", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
         RowBox[{"tabMATCHES", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}], "//", "Total"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"rEFFTAB", ",", 
       RowBox[{"r2", "*", "temp"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.991326936738636*^9, 3.9913270292006807`*^9}, {
  3.991327125717301*^9, 3.991327129528275*^9}, {3.9913273421960707`*^9, 
  3.991327346612061*^9}},
