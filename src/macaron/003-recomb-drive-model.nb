Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["4", 
   RowBox[{"4", " ", "+", " ", 
    RowBox[{"2", "*", "n", "*", "\[Alpha]"}]}]], "*", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"\[Alpha]", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "j"}], " ", "+", " ", "1"}], ")"}]}]}], ")"}], "*", 
     TemplateBox[<|
      "InUUID" -> "2a0aa694-38f9-4474-808a-708325f20f69", "OutUUID" -> 
       "0cbe5b77-4368-4520-92e6-57a3bd3f04dc", "InUUIDOffset" -> 0, 
       "KernelEvalInfoKey" -> {"Global`", 12}, "OutNumber" -> 64, "Status" -> 
       "PercentReferenceExists_KernelY_InY_OutY", "DisplayCache" -> 
       TemplateBox[{"\[Times]"}, "SmartPercent_Infix"]|>,
      "PercentRef"]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "0", ",", " ", 
      RowBox[{"Floor", "[", 
       RowBox[{"n", ",", " ", "2"}], "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.993924909112405*^9, 3.99392495825354*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"d004f807-04c3-402b-a67e-1ffc4546bf57"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", 
   RowBox[{"4", "+", 
    RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]], 
  RowBox[{"(", 
   RowBox[{"2", "+", 
    RowBox[{"2", " ", "\[Alpha]"}], "+", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"2", "-", "n"}]], " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", ",", "2"}], "]"}]}]}]}], "]"}]}], "+", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"2", "-", "n"}]], " ", "\[Alpha]", " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", ",", "2"}], "]"}]}]}]}], "]"}]}], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"1", "-", "n"}]], " ", "n", " ", 
      SqrtBox["\[Pi]"], " ", "\[Alpha]", " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], "]"}]}], 
     RowBox[{
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"1", "+", "n"}], "2"], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "n"}], "2"], "]"}]}]], "-", 
    FractionBox[
     RowBox[{"3", " ", 
      SuperscriptBox["2", 
       RowBox[{"-", "n"}]], " ", 
      SuperscriptBox["n", "2"], " ", 
      SqrtBox["\[Pi]"], " ", "\[Alpha]", " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], "]"}]}], 
     RowBox[{
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"1", "+", "n"}], "2"], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "n"}], "2"], "]"}]}]], "+", 
    FractionBox[
     RowBox[{
      SuperscriptBox["2", 
       RowBox[{"-", "n"}]], " ", 
      SuperscriptBox["n", "3"], " ", 
      SqrtBox["\[Pi]"], " ", "\[Alpha]", " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "n"}], "]"}]}], 
     RowBox[{
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"1", "+", "n"}], "2"], "]"}], " ", 
      RowBox[{"Gamma", "[", 
       FractionBox[
        RowBox[{"2", "+", "n"}], "2"], "]"}]}]], "-", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"3", "-", "n"}]], " ", "\[Alpha]", " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", ",", "2"}], "]"}]}]}]}], "]"}], " ", 
     RowBox[{"Floor", "[", 
      RowBox[{"n", ",", "2"}], "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"HypergeometricPFQ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{
            FractionBox["1", "2"], "-", 
            FractionBox["n", "2"], "+", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", ",", "2"}], "]"}]}], ",", 
           RowBox[{"1", "-", 
            FractionBox["n", "2"], "+", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", ",", "2"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "+", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", ",", "2"}], "]"}]}], ",", 
           RowBox[{
            FractionBox["3", "2"], "+", 
            RowBox[{"Floor", "[", 
             RowBox[{"n", ",", "2"}], "]"}]}]}], "}"}], ",", "1"}], "]"}]}], 
      ")"}]}], "-", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"2", "-", "n"}]], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}], " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", ",", "2"}], "]"}]}]}]}], "]"}], " ", 
     RowBox[{"HypergeometricPFQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{
          FractionBox["1", "2"], "-", 
          FractionBox["n", "2"], "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}], ",", 
         RowBox[{"1", "-", 
          FractionBox["n", "2"], "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}], ",", 
         RowBox[{
          FractionBox["3", "2"], "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}]}], "}"}], ",", "1"}], "]"}]}], "-", 
    RowBox[{
     SuperscriptBox["2", 
      RowBox[{"3", "-", "n"}]], " ", "\[Alpha]", " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"3", "+", 
        RowBox[{"2", " ", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", ",", "2"}], "]"}]}]}]}], "]"}], " ", 
     RowBox[{"HypergeometricPFQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", 
         RowBox[{
          FractionBox["3", "2"], "-", 
          FractionBox["n", "2"], "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}], ",", 
         RowBox[{"2", "-", 
          FractionBox["n", "2"], "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "+", 
          RowBox[{"Floor", "[", 
           RowBox[{"n", ",", "2"}], "]"}]}], ",", 
         RowBox[{
          FractionBox["5", "2"], "+", 
          RowBox[{"Floor", "[", 
