     FractionBox[
      RowBox[{
       SuperscriptBox["n", "2"], " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], ")"}]}], 
  RowBox[{"4", "+", 
