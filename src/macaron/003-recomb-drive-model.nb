Cell[CellGroupData[{

Cell["power drive", "Subsection",
 CellChangeTimes->{{3.993735420158743*^9, 3.993735427050846*^9}, {
  3.99375152904254*^9, 
  3.9937515315158787`*^9}},ExpressionUUID->"b484763d-1f8f-479d-859e-\
fa54c75e3ab2"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\[Beta]", "]"}]], "Input",
 CellChangeTimes->{{3.993920066042698*^9, 3.993920069467371*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"0c784ed3-2f98-42e1-b2c9-971e09bc519c"],

Cell["\<\
we modify multiplicative drive to have a parameter \[Beta] in the exponent, \
modifying the effect of drive:\
\>", "Text",
 CellChangeTimes->{{3.993648821865613*^9, 3.993648824328911*^9}, {
  3.993649047883813*^9, 3.99364910526503*^9}, {3.99391882471585*^9, 
  3.993918853618619*^9}, {3.993918891408967*^9, 
  3.993918914330269*^9}},ExpressionUUID->"920a9cf9-195f-42c3-9e7b-\
73250a600e67"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w\[Alpha]Power", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
     RowBox[{"\[Beta]", " ", "y"}]], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", "\[Alpha]"}], ")"}], 
        RowBox[{"\[Beta]", " ", "y"}]], "[", 
