Notebook[{

Cell[CellGroupData[{
Cell["investigating RF", "Section",
 CellChangeTimes->{{3.99131241529983*^9, 3.991312433679059*^9}, {
  3.991313071492539*^9, 
  3.991313075320009*^9}},ExpressionUUID->"d9d51c0c-ae67-4f6a-85b9-\
4f4aae1c90ab"],

Cell["RF is made from three things:", "Text",
 CellChangeTimes->{{3.9913130914764023`*^9, 3.9913131112860947`*^9}, {
  3.991313260059415*^9, 
  3.991313263760846*^9}},ExpressionUUID->"f6a1e7b6-df99-4db7-afb7-\
12c8b2402113"],

Cell["\<\
We track the vector of crossover events involving chromatids {13,14,23,24} \
where out of n crossovers, n-k start at chromatid 1, i of which end at 3 \
(n-k-i end at 4). Otherwise, k start at chromatid 2, j of which end at 3 (k-j \
end at 4).

Here we assume sisters are never involved in the crossovers (i.e., when the \
DSBs are formed and strand invasion occurs, it isn\[CloseCurlyQuote]t to the \
sister)

Just to clarify, let p equal the chance that the second of the sister \
chromatids is involved in a given crossover event (we\[CloseCurlyQuote]ll set \
p=1/2 next, but it can be hard to know where the factors of 2 come from).\
\>", "Text",
 CellChangeTimes->{{3.9899489415065107`*^9, 3.9899490712617693`*^9}, {
   3.989950165012463*^9, 3.989950240685771*^9}, {3.989950362006055*^9, 
   3.9899504014158583`*^9}, 3.991312955049946*^9, {3.991313839720955*^9, 
   3.991313839859385*^9}},ExpressionUUID->"8df90d9f-3db5-45b8-8817-\
8d615f28335b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["modelling RF", "Section",
 CellChangeTimes->{{3.9913132818756227`*^9, 
  3.991313285720409*^9}},ExpressionUUID->"b37c49ee-9850-4cbd-9d07-\
73565930af21"],

Cell["we define the following two values :", "Text",
 CellChangeTimes->{{3.9913139081915617`*^9, 
  3.9913139185245256`*^9}},ExpressionUUID->"4fe0bda7-708c-484f-82ac-\
7c6c403f5ac5"],

Cell[TextData[{
 StyleBox["match state",
  FontWeight->"Bold"],
 " is a vector",
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["m", "TI"], "1"], ",", 
                    SubscriptBox[
                    StyleBox["m", "TI"], "2"], ",", 
                    SubscriptBox[
                    StyleBox["m", "TI"], "3"], ",", 
                    SubscriptBox[
                    StyleBox["m", "TI"], "4"]}]], "InlineFormula"], " "}]]}}],
               TraditionalForm]]], ")"}], "\[Element]", 
         SuperscriptBox[
          RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{pmatrix} m_1, m_2, m_3, m_4 \\end{pmatrix} \\in \\{ 0, 1 \\}^4",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0d8f077-a265-4aee-8616-e4718fd0f573"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
      "errors" -> {}, "input" -> "m_i = 1", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "f7e5b405-4ae9-46c6-9cb5-9518319daf48"],
 "if the markers on the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "th"}], TraditionalForm]],ExpressionUUID->
  "9b15bc6e-dbc5-4b5a-9ce5-60af0932f028"],
 " chromatid are \[OpenCurlyDoubleQuote]matched\[CloseCurlyDoubleQuote] \
(non-recombinant), and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m_i = 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8f0a7b0b-bb94-4318-b5f7-2d3f7f9a4a50"],
 " otherwise (recombinant)."
}], "Item",
 CellChangeTimes->{{3.991313303913661*^9, 3.9913133714383783`*^9}, {
   3.991313434109227*^9, 3.991313458470862*^9}, {3.991313493521372*^9, 
   3.9913135927637377`*^9}, {3.9913136369105053`*^9, 3.991313721707856*^9}, {
   3.991313873994237*^9, 3.9913138800372458`*^9}, 3.991313915972777*^9, 
   3.9913150816151237`*^9},ExpressionUUID->"9aca51d6-8461-4809-a390-\
434285787576"],

Cell[TextData[{
 StyleBox["event count",
  FontWeight->"Bold"],
 " is a vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["c", "TI"], "1"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "2"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "3"], ",", 
                    SubscriptBox[
                    StyleBox["c", "TI"], "4"]}]], "InlineFormula"], " "}]]}}],
               TraditionalForm]]], ")"}], "\[Element]", 
         SuperscriptBox[
          StyleBox["Z", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{pmatrix} c_1, c_2, c_3, c_4 \\end{pmatrix} \\in \\mathbb{Z}^4", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79788174-71a3-4aa4-a3cb-42052cf63447"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66c6c79a-aa96-43c7-a41f-cce966d20158"],
 " is the number of crossover events the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "th"}], TraditionalForm]],ExpressionUUID->
  "607ef892-de83-4898-b071-e631567f41bc"],
 " chromatid has gone through."
}], "Item",
 CellChangeTimes->{{3.991313303913661*^9, 3.9913133714383783`*^9}, {
   3.991313434109227*^9, 3.991313458470862*^9}, {3.991313493521372*^9, 
   3.991313565352089*^9}, {3.991313725134097*^9, 3.9913137284467707`*^9}, {
   3.991313813980694*^9, 3.991313817381606*^9}, {3.991313855863285*^9, 
   3.991313903320434*^9}, 
   3.9913150881181507`*^9},ExpressionUUID->"0643b259-e389-42a0-922a-\
775fa7f7d41b"],

Cell["\<\
both of these are required to model RF, and neither can be derived from the \
other .\
\>", "Text",
 CellChangeTimes->{{3.991313921336576*^9, 
  3.99131398216849*^9}},ExpressionUUID->"eb8024b6-4d63-4a61-8949-\
7aff291adc71"],

Cell[TextData[{
 "additionally, let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["RF", FontSlant -> "Italic"], "\[Prime]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathit{RF}'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07f311f1-707f-451c-8a16-d07ff42cce79"],
 " be the proportion of chromatids in the tetrad that are unmatched (visibly \
recombinant) ."
}], "Text",
 CellChangeTimes->{{3.9913168102074213`*^9, 
  3.9913168428437147`*^9}},ExpressionUUID->"c3e06a31-8f7f-4967-9470-\
001551038c8f"],

Cell[CellGroupData[{

Cell["match state cannot be derived from event count", "Subsection",
 CellChangeTimes->{{3.99131398465302*^9, 
  3.991313997276206*^9}},ExpressionUUID->"48db48cb-cc04-4ac1-985a-\
2fde026b38c2"],

Cell["our chromatids start out like so:", "Text",
 CellChangeTimes->{{3.991314001937302*^9, 3.99131400530652*^9}, {
   3.9913151466068993`*^9, 3.991315163652214*^9}, {3.991315779866845*^9, 
   3.9913157924663553`*^9}, 3.991315992616794*^9, 
   3.9913160802392187`*^9},ExpressionUUID->"171aba8e-6011-4ea1-a14a-\
db12595cece5"],

Cell[BoxData[{
 RowBox[{"1", " ", ".", 
  RowBox[{"--", 
   RowBox[{"--", 
    RowBox[{"--", "\n", "2"}]}]}], " ", ".", 
  RowBox[{"--", 
   RowBox[{"--", 
    RowBox[{"--", "\n", "3"}]}]}], " ", ".", "xxxxxx"}], "\n", 
 RowBox[{"4", " ", ".", "xxxxxx"}]}], "Code",
 CellChangeTimes->{{3.990559363737032*^9, 3.9905593780318336`*^9}, {
  3.99062360409894*^9, 3.990623608071114*^9}, {3.991315807977104*^9, 
  3.991315814170423*^9}},ExpressionUUID->"bc35dd6f-1016-4231-a58d-\
72c2a833fb7a"],

Cell[TextData[{
 "where ",
 Cell[BoxData["."], "InlineCode",ExpressionUUID->
  "e4cdc342-f4d1-4765-9cfa-d8153d631375"],
 " indicates the centromere. now consider the CO sequence [13, 23]:"
}], "Text",
 CellChangeTimes->{{3.9913157853334723`*^9, 3.9913158186802473`*^9}, {
  3.9913158585884*^9, 3.99131587277556*^9}, {3.991318933808632*^9, 
  3.991318934634602*^9}},ExpressionUUID->"cd444312-d99a-47f2-9207-\
1e47aadf09c9"],

Cell["first crossover: 13:", "Text",
 CellChangeTimes->{{3.9905595760209084`*^9, 3.990559595131379*^9}, 
   3.99131893802178*^9},ExpressionUUID->"06e1c433-3232-447d-8ce3-\
fc8cd5f40e42"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", ".", 
   RowBox[{"--", "-"}]}], "|", "xxx"}], "\n", 
 RowBox[{
  RowBox[{"2", " ", ".", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", "\n", "3"}]}]}], " ", ".", "xxx"}], "|", 
  RowBox[{"--", 
   RowBox[{"-", "\[IndentingNewLine]", 
    RowBox[{"4", " ", ".", "xxxxxx"}]}]}]}]}], "Code",
 CellChangeTimes->{{3.990559598489345*^9, 3.9905596185741158`*^9}, {
  3.9905622238462677`*^9, 3.990562228201544*^9}, {3.990623424036379*^9, 
