Cell["\<\
and a function to calculate the event counts for a given tetrad:\
\>", "Text",
 CellChangeTimes->{{3.992438994293871*^9, 
  3.9924390069290667`*^9}},ExpressionUUID->"840a7bf2-aa91-4426-8802-\
c54fc552e0a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"calculateEventCount", "[", "tetrad_", "]"}], " ", ":=", " ", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
     "Transpose"}], " ", "\[IndentingNewLine]", "//", " ", 
    RowBox[{"Map", "[", 
     RowBox[{"Function", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Unequal", " ", "@@@", 
         RowBox[{"Partition", "[", 
          RowBox[{"#", ",", " ", "2", ",", " ", "1"}], "]"}]}], 
        "\[IndentingNewLine]", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"True", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"False", " ", "->", "0"}]}], "}"}]}], " ", 
       "\[IndentingNewLine]", "//", " ", "Total"}], "\[IndentingNewLine]", 
      "]"}], "]"}]}], "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.992439010162525*^9, 3.9924390172061253`*^9}, {
  3.992475976907958*^9, 3.992475984868127*^9}, {3.992476225377377*^9, 
  3.992476246941826*^9}, {3.992476324285128*^9, 3.9924763443425007`*^9}, {
  3.992476375474244*^9, 3.992476400450279*^9}, {3.992476544226468*^9, 
  3.99247656399632*^9}, {3.992476600602221*^9, 3.992476628510357*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"cdc9779d-e16b-49ac-bed4-2d66b370fdbf"],

