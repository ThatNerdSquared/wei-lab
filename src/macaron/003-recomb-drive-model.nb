Cell[CellGroupData[{

Cell["additive drive", "Subsection",
 CellChangeTimes->{{3.993735397796508*^9, 3.9937354068463*^9}, {
  3.993918850297947*^9, 
  3.993918850519197*^9}},ExpressionUUID->"514c478a-23f2-4813-bd9f-\
dc7630e90869"],

Cell["\<\
we define a function that additively weights the number of COs per chromatid \
by \[Alpha], and then multiplies that by 1 if the chromatid is recombinant \
(and 0 otherwise):\
\>", "Text",
 CellChangeTimes->{{3.993648821865613*^9, 3.993648824328911*^9}, {
  3.993649047883813*^9, 
  3.99364910526503*^9}},ExpressionUUID->"b3961c4e-1d77-4828-9fef-\
f4e0a3799c44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w\[Alpha]Add", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"\[Alpha]", "*", "y"}]}], ")"}], 
    RowBox[{"4", "+", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Alpha]", " ", "*", "y"}], ")"}], "[", 
        RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]}]], " ", "*",
    " ", 
   RowBox[{"Mod", "[", 
    RowBox[{"y", ",", " ", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.993575416953635*^9, 3.9935754773775787`*^9}, {
  3.993575716864176*^9, 3.993575721902451*^9}, {3.9935815972019243`*^9, 
  3.9935816211676617`*^9}, {3.993649063416144*^9, 3.993649067023843*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"a0841af5-a36c-442b-883b-78b91844889a"],

Cell["\<\
and then we define a function that sums the application of this function \
across all chromatids:\
\>", "Text",
 CellChangeTimes->{{3.993654827980854*^9, 
  3.9936548424962673`*^9}},ExpressionUUID->"be87ca7a-4be7-45eb-ba73-\
3c605eb2e25c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"w\[Alpha]Add", "[", "y", "]"}], " ", "//", " ", 
   "Total"}]}]], "Input",
 CellChangeTimes->{{3.993574997467475*^9, 3.9935750149674397`*^9}, {
   3.9936548702379093`*^9, 3.993654873494124*^9}, 3.993735446550385*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"2862af7c-3ec7-4db0-ab58-e0876d8c9f04"],

Cell[TextData[{
 "then ",
 Cell[BoxData[
  TemplateBox[<|"boxes" -> FormBox[
      SubscriptBox[
       StyleBox["m", "TI"], "add"], TraditionalForm], "errors" -> {}, "input" -> 
    "m_{\\text{add}}", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"]], "InlineCode",ExpressionUUID->
  "25ec04cf-fc03-4411-a8d8-5c5157da4204"],
 " is a random variable representing the proportion of recovered chromatids \
that are recombinant:"
}], "Text",
 CellChangeTimes->{{3.993654889723382*^9, 3.993654945057733*^9}, {
  3.993654999988975*^9, 3.9936550593448267`*^9}, {3.993657250917224*^9, 
  3.9936572668447933`*^9}, {3.993657421169228*^9, 3.9936574486845713`*^9}, {
  3.993657648664216*^9, 3.9936576529498672`*^9}, {3.9939190124839773`*^9, 
  3.993919012483994*^9}},ExpressionUUID->"a7508647-9715-4fa0-aba1-\
fdf51285ca41"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mAdd", " ", "=", " ", 
  RowBox[{"g", "[", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2", ",", " ", "x3", ",", " ", "x4"}], "}"}], 
   "]"}]}]], "Input",
