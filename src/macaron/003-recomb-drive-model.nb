Cell["\<\
so causing the number of COs placed on a chromatid to be overdispersed \
disrupts the \[OpenCurlyDoubleQuote]balanced\[CloseCurlyDoubleQuote] \
possibilities and results in oscillation.\
\>", "Text",
 CellChangeTimes->{{3.993921135486907*^9, 
  3.9939211724026413`*^9}},ExpressionUUID->"27cba68f-4790-44b8-bde5-\
db5ddb3a0836"]
}, Open  ]],

Cell[CellGroupData[{

Cell["multiplicative drive", "Subsection",
 CellChangeTimes->{{3.993735420158743*^9, 3.993735427050846*^9}, {
  3.993918848833696*^9, 
  3.9939188490366917`*^9}},ExpressionUUID->"b41bdeab-8252-4b16-b28c-\
ba2499aa4244"],

Cell["\<\
we define a function that additively weights the number of COs per chromatid \
by \[Alpha], and then multiplies that by 1 if the chromatid is recombinant \
(and 0 otherwise):\
\>", "Text",
 CellChangeTimes->{{3.993648821865613*^9, 3.993648824328911*^9}, {
  3.993649047883813*^9, 
  3.99364910526503*^9}},ExpressionUUID->"2e3cb1e6-7206-40ba-8100-\
97d1be079255"],

Cell[BoxData[
 RowBox[{
  RowBox[{"w\[Alpha]Mult", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}], "y"], 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", " ", "+", " ", "\[Alpha]"}], ")"}], "y"], "[", 
       RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "1", ",", " ", "4"}], "}"}]}], "]"}]], " ", "*",
    " ", 
   RowBox[{"Mod", "[", 
    RowBox[{"y", ",", " ", "2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.993575416953635*^9, 3.9935754773775787`*^9}, {
  3.993575716864176*^9, 3.993575721902451*^9}, {3.9935815972019243`*^9, 
  3.9935816211676617`*^9}, {3.993649063416144*^9, 3.993649067023843*^9}, {
  3.993735461328712*^9, 3.993735470530177*^9}, {3.993735846444206*^9, 
  3.993735871321988*^9}, {3.993749851040848*^9, 3.993749870648551*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"a3e32a7d-c498-4339-b3db-bc9ea1ea25a2"],

Cell["\<\
and then we define a function that sums the application of this function \
across all chromatids:\
\>", "Text",
 CellChangeTimes->{{3.993654827980854*^9, 
  3.9936548424962673`*^9}},ExpressionUUID->"ba0bd150-0c36-47b6-be5e-\
751ba5ed5130"],

Cell[BoxData[
 RowBox[{
  RowBox[{"h", "[", "y_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"w\[Alpha]Mult", "[", "y", "]"}], " ", "//", " ", 
   "Total"}]}]], "Input",
 CellChangeTimes->{{3.993574997467475*^9, 3.9935750149674397`*^9}, {
  3.9936548702379093`*^9, 3.993654873494124*^9}, {3.993735879664751*^9, 
  3.993735879988345*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"fb0831e0-e9e7-4cde-9e8b-fd4a11cdcb80"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
