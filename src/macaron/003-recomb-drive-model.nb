       RowBox[{"1", " ", "+", " ", 
        RowBox[{"\[Alpha]", "*", 
         RowBox[{"(", "  ", "1", ")"}]}]}], ")"}], "*", 
      SuperscriptBox["2", 
       RowBox[{"-", "n"}]], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["4", "k"], "/.", 
        RowBox[{"k", "->", " ", 
         FractionBox[
          RowBox[{"n", "-", "1"}], "2"]}]}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{"\[Alpha]", "*", 
        RowBox[{"(", "2", " ", ")"}]}], ")"}], "*", 
      SuperscriptBox["2", 
       RowBox[{"-", "n"}]], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["2", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"2", " ", "k"}]}]], "/.", 
        RowBox[{"k", "->", 
         RowBox[{"n", "/", "2"}]}]}], ")"}]}]}], ")"}]}], "//", 
  "Simplify"}]], "Input",
 CellChangeTimes->{{3.9943553933242598`*^9, 3.9943554275925817`*^9}, {
  3.994355457949753*^9, 3.994355471529313*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"50d955d5-f87b-45d1-ab90-4f98f66527a3"],

