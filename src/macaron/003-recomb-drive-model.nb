  RowBox[{"2", "*", "r", "*", "%"}]}]], "Input",
 CellChangeTimes->{{3.9913261362798567`*^9, 3.991326142020241*^9}, {
  3.9913262284831553`*^9, 3.991326233187901*^9}},
