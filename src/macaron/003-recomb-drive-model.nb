Cell["\<\
and counting how many tags spatially after a given tag, come temporally \
before it:\
\>", "Text",
 CellChangeTimes->{{3.992360975158614*^9, 
  3.992360998851293*^9}},ExpressionUUID->"47059f28-8944-4f6a-bf9d-\
abb236f61679"],

Cell[BoxData[
 RowBox[{
  RowBox[{"countTemporalPredecessors", "[", "sublists_", "]"}], " ", ":=", 
  " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Count", "[", 
     RowBox[{
      RowBox[{"Rest", "[", "#", "]"}], ",", " ", 
      RowBox[{"x_", "/;", " ", 
       RowBox[{"x", " ", "<", " ", 
        RowBox[{"First", "[", "#", "]"}]}]}]}], "]"}], "&"}], " ", "/@", " ", 
   "sublists"}]}]], "Input",
 CellChangeTimes->{{3.9923610097899847`*^9, 3.992361059575205*^9}},
 CellLabel->
  "In[220]:=",ExpressionUUID->"ff74b517-b7e6-4e46-9813-5b572509a870"],

