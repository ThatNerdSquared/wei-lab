Cell["???", "Text",
 CellChangeTimes->{{3.994349780227717*^9, 3.994349783991187*^9}, {
  3.994350154032896*^9, 
  3.994350154323318*^9}},ExpressionUUID->"ad526385-7a8b-4072-945e-\
240cc319a95b"],

Cell[TextData[{
 "let's instead try deriving this ourselves: we know that\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["m", "TI"], "add"], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    FractionBox[
                    RowBox[{"1", "+", "\[Alpha]"}], 
                    RowBox[{"2", "+", "\[Alpha]"}]], ","}]], "InlineFormula"],
                     " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "\[LongEqual]", "1"}]], 
                    "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{"0", ","}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    StyleBox["n", "TI"], "\[LongEqual]", "0"}]], 
                    "InlineFormula"], " "}]]}, {
                 Cell[
                  TextData[{" ", 
                    Cell[
                    BoxData[
                    RowBox[{
                    FractionBox["1", "2"], ","}]], "InlineFormula"], " "}]], 
                 Cell[
                  TextData[{" ", 
                    Cell["otherwise", "InlineFormula"], " "}]]}}], 
              TraditionalForm]]]}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathbb{E}[m_{\\text{add}} | N = n] = \\begin{cases} \
\\frac{1+\\alpha}{2+\\alpha}, &n = 1 \\\\ 0, &n = 0 \\\\ \\frac{1}{2}, \
&\\text{otherwise} \\end{cases}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82ec4d82-4250-4041-882e-d419ed4a4303"],
 ".\nthen by law of total expectation, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["m", "TI"], "add"], "]"}], "\[LongEqual]", 
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             StyleBox["E", FontSlant -> "Plain"], 
             RowBox[{"[", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["m", "TI"], "add"], "|", 
                 StyleBox["N", "TI"]}], "]"}]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathbb{E}[m_{\\text{add}}] = \\mathbb{E}[\\mathbb{E}[m_{\\text{add}} \
| N]]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5e7e62d-1a84-4788-8946-878c30c3051f"],
 ", then\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["m", "TI"], "add"], "]"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]"}], 
          RowBox[{"2", "+", "\[Alpha]"}]], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["N", "TI"], "\[LongEqual]", "1"}], ")"}], "+", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "2"}], "\[Infinity]", 
          LimitsPositioning -> True], 
         FractionBox["1", "2"], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\mathbb{E}[m_{\\text{add}}] = \\frac{1+\\alpha}{2+\\alpha}P(N = 1) + \
\\sum_{k=2}^\\infty \\frac{1}{2}P(N = k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46b36a47-6599-4ead-ab38-03ec73174337"],
 ".\nand then by complement\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           SubscriptBox[
            StyleBox["m", "TI"], "add"], "]"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]"}], 
          RowBox[{"2", "+", "\[Alpha]"}]], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["N", "TI"], "\[LongEqual]", "1"}], ")"}], "+", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             StyleBox["P", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["N", "TI"], "\[LongEqual]", "1"}], ")"}], "-", 
             StyleBox["P", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["N", "TI"], "\[LongEqual]", "0"}], ")"}]}], ")"}]}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbb{E}[m_{\\text{add}}] = \\frac{1+\\alpha}{2+\\alpha}P(N = 1) + \
\\frac{1}{2}(1 - P(N = 1) - P(N = 0))", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68a1ef01-3b68-4408-9eff-a4ef8d8b30c8"],
 "."
}], "Text",
 CellChangeTimes->{{3.994351023998598*^9, 3.99435105337888*^9}, {
  3.9943510887177258`*^9, 3.9943510959197474`*^9}, {3.994351130204241*^9, 
  3.994351171578672*^9}, {3.994351305770487*^9, 3.9943513375768747`*^9}, {
  3.9943513921632633`*^9, 3.99435139735045*^9}, {3.994351487960936*^9, 
  3.99435151559156*^9}},ExpressionUUID->"c7c512e7-9e09-4a92-9dea-\
cab7ec2ac223"],

