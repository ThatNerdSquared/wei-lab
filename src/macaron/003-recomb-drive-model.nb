Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     FractionBox["\[Alpha]", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"3", " ", "n", " ", "\[Alpha]"}], 
