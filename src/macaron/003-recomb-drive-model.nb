Cell["so different \[Beta] compensates for the differences in \[Alpha].", \
"Text",
 CellChangeTimes->{{3.993920111623761*^9, 
  3.993920124509346*^9}},ExpressionUUID->"0aa7cb67-cad2-465e-940f-\
77fb77c13f66"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 "finding a general ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad83cd77-d520-4adc-8ec4-054e507721a7"],
 " formula"
}], "Subsection",
 CellChangeTimes->{{3.9937482696130447`*^9, 3.993748286121293*^9}, {
  3.9939227345070553`*^9, 
  3.9939227488305817`*^9}},ExpressionUUID->"45041194-73cf-44aa-99e0-\
f6d24c002996"],

Cell[CellGroupData[{

Cell["for additive \[Alpha]", "Subsubsection",
 CellChangeTimes->{{3.99417794198495*^9, 
  3.9941779464411507`*^9}},ExpressionUUID->"ff5daad4-678d-4a70-b526-\
b71dbb189cc2"],

Cell[TextData[{
 "we' ve defined ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "X_i | N = n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f17420a-c9c6-44f4-9b6d-2909c10e56bb"],
 " as the number of COs placed on the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "th"}], TraditionalForm]],ExpressionUUID->
  "619923ac-e4f2-4639-85e0-f6218abe13e2"],
 " chromatid, where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], "1"], "\[Tilde]", 
         RowBox[{
           StyleBox["B", "TI"], 
           StyleBox["i", "TI"], 
           StyleBox["n", "TI"]}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", "1", "/", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "X_1 \\sim \\operatorname{Bin}(n, 1/2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8aa4f240-8c30-435b-a8e4-bc3bf8e1ca37"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubscriptBox[
           StyleBox["X", "TI"], "3"], "\[Tilde]", 
          RowBox[{
            StyleBox["B", "TI"], 
            StyleBox["i", "TI"], 
            StyleBox["n", "TI"]}], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["n", "TI"], ",", "1", "/", "2"}], ")"}]}], 
        TraditionalForm], "errors" -> {}, "input" -> 
      "X_3 \\sim \\operatorname{Bin}(n, 1/2)", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], ",", " "}], TraditionalForm]],ExpressionUUID->
  "c9a3533f-acb2-458a-9dd2-3f94f9e08d8e"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], "2"], "\[LongEqual]", 
         StyleBox["n", "TI"], "-", 
         SubscriptBox[
          StyleBox["X", "TI"], "1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "X_2 = n - X_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47bca07a-44f4-43d8-b157-76da359ba80d"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], "4"], "\[LongEqual]", 
         StyleBox["n", "TI"], "-", 
         SubscriptBox[
          StyleBox["X", "TI"], "3"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "X_4 = n -X_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5a11c31-85a0-4835-b49a-3345084f6a94"],
 ".\n\nthen the weighted-recombinant-state from a combination of w\[Alpha] \
functions + mod can be expressed as a random variable:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"], 
              StyleBox["r", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]", 
            SubscriptBox[
             StyleBox["X", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"4", "+", "2", 
            StyleBox["n", "TI"], "\[Alpha]"}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"]], "  ", "mod", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(X_i^r | N = n) = \\frac{1 + \\alpha X_i}{4 + 2n\\alpha} (X_i \\mod 2)",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2deb92f7-1d20-41e9-afc9-f0652fe96a52"],
 ".\n\nand then the recombinant state of the tetrad is just a sum of these:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "add"], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", "1", "4", LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"], 
          StyleBox["r", "TI"]], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M_{\\text{add}} | N = n = \\sum_1^4 X_i^r | N = n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2f24fe4-2fda-4cfa-b416-f93fe52f44b5"],
 ".\nand then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "992bb8ed-1552-4bba-8e14-9a087e304d10"],
 " is just the expectation of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> "M", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86f8ed89-38ef-4d1e-bd29-c202264aac76"],
 ", conditioned on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "649fff24-ca55-4ad6-a2b3-32d6381cc3ba"],
 ":\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["M", "TI"], "add"], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "r_{\\text{eff}} = \\mathbb{E}[M_{\\text{add}} | N = n]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "342f8de0-62d9-466c-96b7-b6dd2f1720d8"],
 "."
}], "Text",
 CellChangeTimes->{{3.9939235950917797`*^9, 3.993923675493341*^9}, {
  3.993923732841248*^9, 3.9939237458430357`*^9}, {3.9939238163831987`*^9, 
  3.99392384226322*^9}, {3.993923874950263*^9, 3.993923892717824*^9}, {
  3.993924244455291*^9, 
  3.99392425756603*^9}},ExpressionUUID->"305cfd2c-3b2d-4221-9474-\
3d39cc89d534"],

Cell[TextData[{
 "then by linearity of expectation,\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"], 
              StyleBox["r", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "r_{\\text {eff}} = \\sum_{i=1}^4\\mathbb {E}[X_i^r | N = n]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2aa11672-d350-4b9a-abc9-32976ee93ed7"],
 "\nexpanding the definition of the expectation,\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]", 
            StyleBox["k", "TI"]}], 
          RowBox[{"4", "+", "2", 
            StyleBox["n", "TI"], "\[Alpha]"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["k", "TI"], "  ", "mod", "2"}], ")"}], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "r_{\\text {eff}} = \\sum_{i=1}^4\\sum_{k = 0}^n \\frac{1 + \\alpha k}{4 \
+ 2n\\alpha}(k \\mod 2)P(X_i = k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ba08442-f723-42a3-9f6b-268a630c073a"],
 "\nwe can remove the mod operation by changing the index of the inner sum, \
by transforming ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", "2", 
         StyleBox["j", "TI"], "+", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "k = 2j + 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fc5d717-7660-4ab7-9c28-2e691a39844c"],
 ":\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         FractionBox[
          RowBox[{"1", "+", "\[Alpha]", 
            RowBox[{"(", 
              RowBox[{"2", 
                StyleBox["j", "TI"], "+", "1"}], ")"}]}], 
          RowBox[{"4", "+", "2", 
            StyleBox["n", "TI"], "\[Alpha]"}]], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", "2", 
             StyleBox["j", "TI"], "+", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "r_{\\text {eff}} = \\sum_{i=1}^4\\sum_{j = 0}^{\\lfloor n / 2 \\rfloor} \
\\frac{1 + \\alpha (2j + 1)}{4 + 2n\\alpha}P(X_i = 2j + 1)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e6267e6a-c129-41df-a918-b2baa07ae0ad"],
 "\npulling out the factor of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        FractionBox["1", 
         RowBox[{"4", "+", "2", 
           StyleBox["n", "TI"], "\[Alpha]"}]], TraditionalForm], 
      "errors" -> {}, "input" -> "\\frac{1}{4 + 2n\\alpha}", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"], ":"}], TraditionalForm]],ExpressionUUID->
  "0fbb561a-fe7b-4647-86a4-a931de11bd2c"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         FractionBox["1", 
          RowBox[{"4", "+", "2", 
            StyleBox["n", "TI"], "\[Alpha]"}]], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]", 
             RowBox[{"(", 
               RowBox[{"2", 
                 StyleBox["j", "TI"], "+", "1"}], ")"}]}], ")"}], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", "2", 
             StyleBox["j", "TI"], "+", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "r_{\\text {eff}} = \\frac{1}{4 + 2n\\alpha}\\sum_{i=1}^4\\sum_{j = 0}^{\
\\lfloor n / 2 \\rfloor} (1 + \\alpha (2j + 1))P(X_i = 2j + 1)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01612958-a4aa-4071-992d-f742da338835"],
 "\neliminating the outer sum, by symmetry:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         FractionBox["4", 
          RowBox[{"4", "+", "2", 
            StyleBox["n", "TI"], "\[Alpha]"}]], 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{"\[LeftFloor]", 
            RowBox[{
              StyleBox["n", "TI"], "/", "2"}], "\[RightFloor]"}], 
          LimitsPositioning -> True], 
         RowBox[{"(", 
           RowBox[{"1", "+", "\[Alpha]", 
             RowBox[{"(", 
               RowBox[{"2", 
                 StyleBox["j", "TI"], "+", "1"}], ")"}]}], ")"}], 
         StyleBox["P", "TI"], 
