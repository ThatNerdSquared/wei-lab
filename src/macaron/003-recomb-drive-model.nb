Cell["\<\
When a chromatid is chosen, the following determines if it looks recombinant, \
given one cross-over event:\
\>", "Text",
 CellChangeTimes->{{3.991325989539358*^9, 3.9913260067561817`*^9}, {
  3.991326114667056*^9, 3.991326122278533*^9}, {3.991408486715925*^9, 
  3.991408497553956*^9}},ExpressionUUID->"b03c923a-1758-4b6a-a4f6-\
e03c9b9c62f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"tabBIAS", "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
     RowBox[{"tabMATCHES", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "//", "Total"}]], "Input",
 CellChangeTimes->{{3.99132566279348*^9, 3.991325695892681*^9}, {
   3.9913257420987883`*^9, 3.991325745455518*^9}, 3.991325880781013*^9, 
   3.991325982174624*^9, {3.991326065508288*^9, 3.991326067245091*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"e1e9c25b-f59b-47f9-9106-0698b5eb0647"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.991325772835959*^9, 3.991325881550418*^9, 
  3.991325982769425*^9, 3.991326067880453*^9, 3.991326139603593*^9, 
  3.991326237338458*^9, 3.9923523661646347`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"eb425290-3c94-4a65-95a1-91caff13dff9"]
}, Open  ]],

Cell["\<\
If there was an 2r chance of 1 crossover (so that each chromatid has a chance \
of r of having one crossover) and otherwise no recombination events, then \
bias will change this by an amount:\
\>", "Text",
 CellChangeTimes->{{3.9913255906041403`*^9, 3.991325644618166*^9}, {
  3.991326173971485*^9, 
  3.991326179124524*^9}},ExpressionUUID->"98daa1bc-b4db-4bca-b378-\
6883aeedb70a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEFF", "=", 
  RowBox[{"2", "*", "r", "*", "%"}]}]], "Input",
 CellChangeTimes->{{3.9913261362798567`*^9, 3.991326142020241*^9}, {
  3.9913262284831553`*^9, 3.991326233187901*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"36e800e5-2d32-4cdd-9336-d8d542c3c5ec"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", "r", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.991326142426478*^9, 3.991326237453845*^9, 
  3.992352366169231*^9},
 CellLabel->"Out[12]=",ExpressionUUID->"9ec88747-1dfd-4294-a9a6-16b35fddccac"]
}, Open  ]],

Cell["In the absence of a bias:", "Text",
