     RowBox[{"\[Alpha]", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "j"}], " ", "+", " ", "1"}], ")"}]}]}], ")"}], "*", 
   
   SuperscriptBox["2", 
    RowBox[{"-", "n"}]], " ", 
