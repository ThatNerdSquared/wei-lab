Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "x1"}], ")"}], " ", "\[Alpha]"}]}], ")"}], " ", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"n", "-", "x1"}], ",", "2"}], "]"}]}], 
