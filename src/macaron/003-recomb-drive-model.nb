  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", "-", "x3"}], ")"}], " ", "\[Alpha]"}]}], ")"}], " ", 
    RowBox[{"Mod", "[", 
