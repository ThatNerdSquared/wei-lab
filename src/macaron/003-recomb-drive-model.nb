  3.992360805100114*^9}},ExpressionUUID->"36ac8632-ea70-44ed-bef1-\
7426969bc7a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildReverseAccumulateds", "[", "tags_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Take", "[", 
     RowBox[{"tags", ",", " ", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "*", " ", "#"}]}], "]"}], "&"}], " ", "/@", 
   " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "tags", "]"}], " ", "//", " ", "Range"}], " ", "//",
      " ", "Reverse"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.992360806723802*^9, 3.9923608827426*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"cd54b24e-20db-47b9-9fce-792d7585e12a"],

