Cell["case II: 2,3 -> 1,3", "Subsubsection",
 CellChangeTimes->{{3.9905596761531677`*^9, 
  3.990559684470282*^9}},ExpressionUUID->"fed34f10-57db-4861-996c-\
60de762b2f26"],

Cell["first crossover: 2,3:", "Text",
 CellChangeTimes->{{3.990559686879497*^9, 
  3.990559701774932*^9}},ExpressionUUID->"f892d3db-9c13-4b1a-b542-\
5592cb4b915e"],

Cell[BoxData[
 RowBox[{
  RowBox[{".", 
   RowBox[{"--", "-"}]}], "|", 
  RowBox[{"--", 
   RowBox[{"-", "\n", 
    RowBox[{".", 
     RowBox[{"--", "-"}]}]}]}], "|", 
  RowBox[{"xxx", "    ", "<", 
   RowBox[{"-", "\n", 
    RowBox[{".", "xxx"}]}]}], "|", 
  RowBox[{
   RowBox[{"--", "-"}], "    ", "<", 
   RowBox[{"-", "\[IndentingNewLine]", 
    RowBox[{".", "xxx"}]}]}], "|", "xxx"}]], "Code",
 CellChangeTimes->{{3.990623501398245*^9, 
  3.990623596325062*^9}},ExpressionUUID->"531c449b-dc52-4fc5-bc52-\
28e619ff7fab"],

Cell["second crossover: 1,3:", "Text",
 CellChangeTimes->{{3.99062350300001*^9, 
  3.990623519577076*^9}},ExpressionUUID->"a143b72d-988b-4042-8506-\
588e740bb7da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{".", 
   RowBox[{"--", "--"}]}], "|", 
  RowBox[{"--", "    ", 
   RowBox[{"<", 
    RowBox[{"-", "\n", 
     RowBox[{".", 
      RowBox[{"--", 
       RowBox[{"-", "x"}]}]}]}]}]}], "|", "xx"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{".", "xxx"}], "-"}], "|", 
  RowBox[{"--", "    ", 
   RowBox[{"<", 
    RowBox[{"-", "\[IndentingNewLine]", 
     RowBox[{".", "xxxx"}]}]}]}], "|", "xx"}]}], "Code",
 CellChangeTimes->{{3.990623520644485*^9, 
  3.9906235906570263`*^9}},ExpressionUUID->"08a43613-6101-4859-9ab5-\
2b9825f1c08d"],

Cell["\<\
so crossover order matters (even if location + strand configuration + CO \
count per chromatid is the same, order of placement can change what haplotype \
arrangements we get).
how do we handle this?\
\>", "Text",
 CellChangeTimes->{{3.9906239183361483`*^9, 3.990623930382369*^9}, {
  3.990624047406201*^9, 3.990624076590124*^9}, {3.990625138483914*^9, 
  3.990625142444664*^9}},ExpressionUUID->"a35f230c-9daa-4ba3-a00e-\
45cb1057a095"],

Cell["\<\
in the example above, the change in RF is the same: the double-CO chromatid \
has no visible CO, and neither does the chromatid with the single sister-CO. \
can we use this to disregard the diff haplotype arrangements?
-> i don\[CloseCurlyQuote]t think so, bc the non-visible COs still affect \
drive\
\>", "Text",
 CellChangeTimes->{{3.990625665331061*^9, 3.990625683066106*^9}, {
  3.990626325863163*^9, 
  3.990626396709675*^9}},ExpressionUUID->"882a2a33-bc14-47ea-8382-\
733bba589db0"],

Cell[CellGroupData[{

Cell[BoxData["curr"], "Input",
 CellChangeTimes->{{3.990710891789366*^9, 3.990710921468596*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"c1026b43-6d2d-4523-b099-ac896434fc57"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"4", ",", "0", ",", "1", ",", "3"}], "}"}]], "Output",
 CellChangeTimes->{3.990710921840753*^9},
 CellLabel->"Out[79]=",ExpressionUUID->"c84497eb-2005-4194-8440-85b0f71ad11d"]
}, Open  ]],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.990710923827382*^9, 3.990710960689693*^9}, {
  3.990711000892617*^9, 3.9907110016089067`*^9}, {3.990711119422875*^9, 
  3.990711144122374*^9}},ExpressionUUID->"e0d5b91b-5b1d-4669-9d31-\
92d8068c8fc8"],

Cell[TextData[{
 "\nlet RFc be the part of RF determined just from the chromatid \
configuration (not weighted by P(crossover in region) or P(recovery)). then:\n\
- RFc is fully determined by the match-mismatch state\n- RFc ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Element]", 
         RowBox[{"{", 
           RowBox[{"0", ",", "0.5", ",", "1"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\in \\{ 0, 0.5, 1 \\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a07eb95f-ba7e-4ad7-afe2-7c9f90fc6c48"],
 "\n- the ",
 StyleBox["current match-mismatch state",
  FontWeight->"Bold"],
 " + the ",
 StyleBox["next pair",
  FontWeight->"Bold"],
 " fully determines the ",
 StyleBox["next match-mismatch state",
  FontWeight->"Bold"],
 "\n- what gets \[OpenCurlyDoubleQuote]recombined \
away\[CloseCurlyDoubleQuote]?\n\t- presumably, part from centromere->telomere \
(centromere never gets \[OpenCurlyDoubleQuote]recombined away\
\[CloseCurlyDoubleQuote])?\n\t- assume acrocentric chromosome for now\n- (1) \
match-mismatch is order-sensitive, but not location-sensitive\n- (2) \
events-per-chromatid is location-sensitive, but not order-sensitive\n- from \
(1) and (2), neither match-mismatch state nor events-per-chromatid can be \
determined from pair-conf + strand-conf alone\n- we need both match-mismatch \
and events-per-chromatid: match-mismatch => RF, events-per-chromatid => drive \
weights"
}], "Text",
 CellChangeTimes->{{3.990716273688693*^9, 3.990716429444125*^9}, {
  3.990716669430398*^9, 3.9907167432187634`*^9}, {3.990716921276011*^9, 
  3.9907169855457163`*^9}, {3.990717212392152*^9, 
  3.990717316647058*^9}},ExpressionUUID->"bacb035f-8bb2-4e63-9349-\
1326f56f0c2e"],

Cell["\<\



RF is from P(recomb), match-mismatch state, P(recovery)
match-mismatch state: doesn\[CloseCurlyQuote]t matter where you place COs, \
but order of pair involvement matters!!
\tdepending on what gets \[OpenCurlyDoubleQuote]recombied away\
\[CloseCurlyDoubleQuote], could also be location-sensitive
for P(recovery), need COs-per-strand
\tHOWEVER: not necessarily recoverable from pair-conf, since COs can be \
\[OpenCurlyDoubleQuote]recombined away\[CloseCurlyDoubleQuote]!!\
\>", "Text",
 CellChangeTimes->{{3.990722450297584*^9, 3.990722643288224*^9}, 
   3.991310787306069*^9},ExpressionUUID->"35d64f88-9fac-4e1c-a208-\
8efdf0358914"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
