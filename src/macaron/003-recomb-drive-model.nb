Cell[TextData[{
 "so once again we need to manually simplify this expectation, at least to an \
extent. but unlike the additive case, it\[CloseCurlyQuote]s more complicated \
to determine ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["Y", "TI"], 
              StyleBox["i", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbb {E}[Y_i| N = n]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "635a37e8-b4fd-4ab7-af2c-754d70ad059e"],
 " as each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Y", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Y_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29bfe563-30d6-4506-82a8-27196581e037"],
 " is dependent on other ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "X_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2fa45dc3-abc3-481a-aaf5-9e3ae5a06db5"],
 "s (from the denominator). then to find this expectation, we need the joint \
distribution of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42992fed-3682-4601-acd2-e93d16f0e2db"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], ":", "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", "1", "4", LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "S := \\sum_1^4 T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f49da5cd-b9b3-4b9e-9c19-ded24310029a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          SubscriptBox[
           StyleBox["X", "TI"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i = (1 + \\alpha)^{X_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cbc35a5-4efc-419b-9613-15256e064277"],
 ".\nwe can first subtract out ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i = k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67e7648b-fd65-4233-82d9-24d1a7f695d3"],
 " from the sum:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["s", "TI"], "-", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(T_i = k, S = s) = P(T_i = k, T_j + T_k + T_l = s - k)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f868a5db-0696-4e9f-906d-9ecaca1ccadd"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"], ",", 
         StyleBox["l", "TI"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "j, k, l \\in \\{ 1, 2, 3, 4 \\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3463932-24dd-4f42-9ea4-e1e09f63b071"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"], ",", 
         StyleBox["l", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "j, k, l \\neq i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9279e29e-6860-43c4-84d9-ef8d4967b778"],
 ".\nassume WLOG that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "X_i, X_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0090d864-b090-4236-9ecb-401255216eba"],
 " are sisters. then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8755a562-b691-42f6-8398-33942f707afe"],
 " is fully determined by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0b676a0-1b1c-4b7b-8295-ee1f0612d755"],
 ": it is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
        RowBox[{
          StyleBox["n", "TI"], "-", 
          SubscriptBox["log", 
           RowBox[{"1", "+", "\[Alpha]"}]], 
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["i", "TI"]], ")"}]}]], TraditionalForm], "errors" -> {},
      "input" -> "(1+\\alpha)^{n - \\log_{1+\\alpha}(T_i)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2c53a44-6b4a-43f5-9dd0-463d33ee1c35"],
 ". then:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["s", "TI"], "-", 
             StyleBox["k", "TI"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
              RowBox[{
                StyleBox["n", "TI"], "-", 
                SubscriptBox["log", 
                 RowBox[{"1", "+", "\[Alpha]"}]], 
                RowBox[{"(", 
                  StyleBox["k", "TI"], ")"}]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P(T_i = k, S = s) = P(T_i = k, T_k + T_l = s - k - (1 + \\alpha)^{n - \
\\log_{1+\\alpha}(k)})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5abd789-8ed1-4940-b48f-37cc805a6e0b"],
 ".\nlet ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["s", "TI"], "-", 
         StyleBox["k", "TI"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          RowBox[{
            StyleBox["n", "TI"], "-", 
            SubscriptBox["log", 
             RowBox[{"1", "+", "\[Alpha]"}]], 
            RowBox[{"(", 
              StyleBox["k", "TI"], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "b = s - k - (1 + \\alpha)^{n - \\log_{1+\\alpha}(k)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48846646-3585-43d0-b708-b2793b894422"],
 " for notational simplicity.\nthen by the chain rule:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["b", "TI"], "|", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(T_i = k, S = s) = P(T_k + T_l = b | T_i = k)P(T_i = k)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd08de3e-035d-4914-837e-0d8fbc2bd08e"],
 "."
}], "Text",
 CellChangeTimes->{{3.995554308639661*^9, 3.9955544830373697`*^9}, {
   3.995554681378675*^9, 3.99555475569729*^9}, {3.995554951802403*^9, 
   3.995555045576806*^9}, {3.9955550799488487`*^9, 3.9955550905262938`*^9}, {
   3.99555516955805*^9, 3.99555522459378*^9}, 3.995555690532028*^9, {
   3.995561172269113*^9, 3.9955611758723583`*^9}, {3.9955612632292356`*^9, 
   3.995561263359736*^9}, {3.995561339837964*^9, 3.995561358524332*^9}, {
   3.995562728007696*^9, 3.9955627435054893`*^9}, 3.995646730576635*^9, 
   3.995653977105432*^9, 3.995654353961359*^9, 3.995654404030335*^9, {
   3.995654568536559*^9, 
   3.9956545907992687`*^9}},ExpressionUUID->"dd4d1cd8-ea40-4f43-afcb-\
f4e36a52070a"],

Cell[TextData[{
 "the second factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["i", "TI"]], "\[LongEqual]", 
           StyleBox["k", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P(T_i = k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa44e638-5cc0-48dc-95c7-f0c1fc946ab4"],
 " is easy to find - it\[CloseCurlyQuote]s equivalent to when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["log", 
          RowBox[{"1", "+", "\[Alpha]"}]], 
         RowBox[{"(", 
           StyleBox["k", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "X_i = \\log_{1+\\alpha}(k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db587de8-5923-4759-85bd-ef5057656daa"],
 ". then since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"], "\[Tilde]", 
         RowBox[{
           StyleBox["B", "TI"], 
           StyleBox["i", "TI"], 
           StyleBox["n", "TI"]}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], ",", "1", "/", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "X_i |N = n \\sim \\operatorname{Bin}(n, 1/2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "94f521ea-78b8-4688-b88d-177aadf43bc5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9956466029002733`*^9, 
  3.995646685036017*^9}},ExpressionUUID->"98cf02fd-d132-461c-91a2-\
b423edc5d6e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pTi", "[", "k_", "]"}], ":=", 
  RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"1", "+", "\[Alpha]"}], ",", " ", "k"}], "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"0", " ", "<=", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"1", "+", "\[Alpha]"}], ",", " ", "k"}], "]"}], " ", "<=", 
      " ", "n"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pTi", "[", "k", "]"}]}], "Input",
 CellChangeTimes->{{3.995563906794239*^9, 3.995563912424055*^9}, {
   3.9955650800091133`*^9, 3.995565131364291*^9}, {3.995565175095233*^9, 
   3.995565184344558*^9}, 3.995565445890785*^9, {3.995646809867259*^9, 
   3.995646811667931*^9}},
 CellLabel->
  "In[111]:=",ExpressionUUID->"0c1adf59-208e-4f84-8c1e-5152544fefbf"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["2", 
   RowBox[{"-", "n"}]], " ", 
  RowBox[{"Binomial", "[", 
   RowBox[{"n", ",", 
    FractionBox[
     RowBox[{"Log", "[", "k", "]"}], 
     RowBox[{"Log", "[", 
      RowBox[{"1", "+", "\[Alpha]"}], "]"}]]}], "]"}]}]], "Output",
 CellChangeTimes->{3.995646812435491*^9},
 CellLabel->
  "Out[112]=",ExpressionUUID->"ca239a91-0c89-4d1d-8df4-2c37e83ae9ce"]
}, Open  ]],

Cell[TextData[{
 "however, the first factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         RowBox[{
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["k", "TI"]], "+", 
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["l", "TI"]], "\[LongEqual]", 
           StyleBox["b", "TI"], "|", 
           SubscriptBox[
            StyleBox["T", "TI"], 
            StyleBox["i", "TI"]], "\[LongEqual]", 
           StyleBox["k", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P(T_k + T_l = b | T_i = k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1dd083b6-0b59-48bc-a5e2-86b35a2af367"],
 " is harder: it\[CloseCurlyQuote]s a function of 2 random variables (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2b6182f-4d21-407a-9d47-69a635436087"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["l", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_l", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d09db35d-1c29-4d92-a92c-6d0379a1d257"],
 "): \n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["k", "TI"]], "+", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          SubscriptBox[
           StyleBox["X", "TI"], 
           StyleBox["k", "TI"]]], "+", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          SubscriptBox[
           StyleBox["X", "TI"], 
           StyleBox["l", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_k + T_l = (1+\\alpha)^{X_k} + (1+\\alpha)^{X_l}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4126fd2d-389a-47b1-b3aa-e9109f7fc603"],
 "\nsince ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", 
         StyleBox["n", "TI"], "-", 
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "X_l = n - X_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41d4791e-370a-4248-954b-f249d7070f49"],
 ", we can simplify this to a function of 1 variable:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["k", "TI"]], "+", 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["l", "TI"]], "\[LongEqual]", 
         StyleBox["d", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["X", "TI"], 
            StyleBox["k", "TI"]], ")"}], ":", "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          SubscriptBox[
           StyleBox["X", "TI"], 
           StyleBox["k", "TI"]]], "+", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          RowBox[{
            StyleBox["n", "TI"], "-", 
            SubscriptBox[
             StyleBox["X", "TI"], 
             StyleBox["k", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "T_k + T_l = d(X_k) := (1+\\alpha)^{X_k} + (1+\\alpha)^{n - X_k}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "406c6f1e-74d4-45e3-8d85-c86fa72bfea7"],
 "\nthen ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["k", "TI"]], "\[LongEqual]", 
             SuperscriptBox[
              StyleBox["d", "TI"], "-1"], 
             RowBox[{"(", 
               StyleBox["a", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "P(T_k + T_l = a) = P(X_k = d^{-1}(a))", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5821e1e-2ae3-40e0-b7d9-dec08b60ce28"],
 ".\nhowever, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "-1"], TraditionalForm], "errors" -> {}, "input" -> 
     "d^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1f23d25-7984-4eb9-96a3-5d67aa009a2f"],
 " is not necessarily a function, since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a0ae592-db59-4420-8713-c33ae3abcf43"],
 " is not necessarily 1-to-1:"
}], "Text",
 CellChangeTimes->{{3.9956468175908003`*^9, 3.995646849007516*^9}, {
  3.995653123110511*^9, 3.995653146598068*^9}, {3.995653264225058*^9, 
  3.995653270797357*^9}, {3.995653581794321*^9, 3.995653593725576*^9}, {
  3.9956536934664087`*^9, 3.995653787476742*^9}, {3.9956538645539837`*^9, 
  3.995653947442601*^9}},ExpressionUUID->"7e733fcf-5ee2-47bb-9fb9-\
9115ec982a1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
