Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"BinomialDistribution", "[", 
      RowBox[{"n", ",", " ", 
       RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", 
