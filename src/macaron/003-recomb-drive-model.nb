Cell["we do this by creating \[OpenCurlyDoubleQuote]reverse accumulated\
\[CloseCurlyDoubleQuote] lists:", "Text",
 CellChangeTimes->{{3.992360747287722*^9, 
  3.992360805100114*^9}},ExpressionUUID->"36ac8632-ea70-44ed-bef1-\
7426969bc7a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildReverseAccumulateds", "[", "tags_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Take", "[", 
     RowBox[{"tags", ",", " ", 
      RowBox[{
       RowBox[{"-", "1"}], " ", "*", " ", "#"}]}], "]"}], "&"}], " ", "/@", 
   " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "tags", "]"}], " ", "//", " ", "Range"}], " ", "//",
      " ", "Reverse"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.992360806723802*^9, 3.9923608827426*^9}},
 CellLabel->
  "In[218]:=",ExpressionUUID->"cd54b24e-20db-47b9-9fce-792d7585e12a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"extractTags", "[", "testSpatOrd", "]"}], " ", "//", " ", 
  "buildReverseAccumulateds"}]], "Input",
 CellChangeTimes->{{3.9923608863039017`*^9, 3.9923608915687647`*^9}, {
  3.99236126659519*^9, 3.992361269535693*^9}, {3.9923617395705957`*^9, 
