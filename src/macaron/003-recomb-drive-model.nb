  3.9941769059390507`*^9}},ExpressionUUID->"9df66068-0962-4203-a33d-\
a40f539e63a6"],

Cell[TextData[{
 "can mathematica do this summation? first, finding a formula for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "(", 
         RowBox[{
           SubscriptBox[
            StyleBox["X", "TI"], 
            StyleBox["i", "TI"]], "\[LongEqual]", "2", 
           StyleBox["j", "TI"], "+", "1"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P(X_i = 2j + 1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76a863cb-1efa-4151-a2d3-8405fd163ca9"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993924570146844*^9, 3.993924577858183*^9}, {
  3.9941769449710617`*^9, 
  3.994176963075811*^9}},ExpressionUUID->"15803585-f4c6-421c-ba22-\
cca55624dfbf"],

