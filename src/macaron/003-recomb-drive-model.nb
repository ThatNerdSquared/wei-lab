Cell[TextData[{
 "so we can prove that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07b5d03e-ede0-470e-9fbc-1009168c299c"],
 " is 1/2 for all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67ab0694-7486-4eb7-9983-db7baae04782"],
 " - in other words, additive drive has no effect."
}], "Text",
 CellChangeTimes->{{3.9941771345120487`*^9, 3.994177150755539*^9}, {
  3.994177227436315*^9, 
  3.994177241374962*^9}},ExpressionUUID->"0083fbff-6343-48e8-95a3-\
35f1b06c8c2d"],

Cell[TextData[{
 "note that the above summation doesn\[CloseCurlyQuote]t capture what we see \
for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n = 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f34e0ce3-3fda-47b7-96f7-624ca6513038"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994177268087554*^9, 
  3.994177321262884*^9}},ExpressionUUID->"86674d94-6dd4-40a9-9dc4-\
affc0f8622a5"],

