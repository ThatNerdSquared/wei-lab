2a1819556e2c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expectedlens", " ", "=", " ", 
   RowBox[{
    RowBox[{"4", "^", "x"}], " ", "/.", 
    RowBox[{"x", "->", 
     RowBox[{"Range", "[", "n", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"actuallens", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Range", "[", "n", "]"}], " ", "//", " ", 
     RowBox[{
      RowBox[{"buildCOPairTable", " ", "/@", " ", "#"}], "&"}]}], " ", "//", 
    RowBox[{
     RowBox[{"Length", " ", "/@", "#"}], "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"expectedlens", "==", "actuallens"}]}], "Input",
 CellChangeTimes->{{3.992096590019993*^9, 3.99209659474231*^9}, {
  3.9920966749998827`*^9, 3.992096766267749*^9}, {3.992096814637309*^9, 
