Cell[CellGroupData[{

Cell["for multiplicative \[Alpha]", "Subsubsection",
 CellChangeTimes->{{3.995630359956951*^9, 
  3.995630400520718*^9}},ExpressionUUID->"fd3235ef-16cd-4ea5-a124-\
b456e6a06ef4"],

Cell["\<\
since we don\[CloseCurlyQuote]t yet have a general formula for multiplicative \
\[Alpha], let\[CloseCurlyQuote]s do this numerically. assume that there are \
<=20 COs per tetrad (probably a reasonable assumption), and that P(N > 20) is \
negligible enough that truncating the distribution at N = 20 won\
\[CloseCurlyQuote]t affect our results.\
\>", "Text",
 CellChangeTimes->{{3.995630402276366*^9, 
  3.995630463081971*^9}},ExpressionUUID->"98d2555b-f1be-47fa-9f7a-\
000de3df66f2"],

Cell["then we generate reff for N \[Element] [0, 20]:", "Text",
 CellChangeTimes->{{3.995630469414579*^9, 
  3.995630498071109*^9}},ExpressionUUID->"f942c708-5c7b-4627-9e9c-\
4277f46fe8a0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reffmults", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"reffMult", "[", "n", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "0", ",", " ", "20"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995630488428149*^9, 3.995630516981103*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"f44c3134-c792-4c7b-ba8e-2b2d04d48902"],

Cell["\<\
we then generate the poisson-distribution probabilities for 0 to 20:\
\>", "Text",
 CellChangeTimes->{{3.995630527696342*^9, 
  3.9956305358778477`*^9}},ExpressionUUID->"3b45c8a1-754a-450a-88df-\
a5a3bcfcfbca"],

