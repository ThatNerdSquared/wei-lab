Cell["\<\
define an expression for the body of the expectation summation:\
\>", "Text",
 CellChangeTimes->{{3.994350999776092*^9, 
  3.9943510094499407`*^9}},ExpressionUUID->"1e893f32-3b68-488c-8060-\
2d8c43f2f639"],

Cell[BoxData[
 RowBox[{
  RowBox[{"innersum", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"additiveReffOddN", "[", "x", "]"}], "*", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"PoissonDistribution", "[", "\[Lambda]", "]"}], ",", " ", 
       "x"}], "]"}], ",", " ", 
     RowBox[{"x", " ", ">=", " ", "0"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.994349959281959*^9, 3.9943499655985403`*^9}, 
   3.994350137175407*^9},
 CellLabel->"In[74]:=",ExpressionUUID->"41bbfc00-495a-4f71-8e63-db2abda1cada"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"innersum", "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.994350160061489*^9, 3.994350162328059*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"493ac401-6f88-43dc-b4d7-931976cb1a31"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "\[Lambda]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     FractionBox["\[Alpha]", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "x"}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"3", " ", "x", " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "x"}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["x", "2"], " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "x"}], ")"}]}]]}], ")"}], " ", 
   SuperscriptBox["\[Lambda]", "x"]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"4", "+", 
     RowBox[{"2", " ", "x", " ", "\[Alpha]"}]}], ")"}], " ", 
   RowBox[{"x", "!"}]}]]], "Output",
 CellChangeTimes->{3.994350162796302*^9},
 CellLabel->"Out[78]=",ExpressionUUID->"9b6a8749-d80b-45d4-b5aa-46728dc9a37d"]
}, Open  ]],

