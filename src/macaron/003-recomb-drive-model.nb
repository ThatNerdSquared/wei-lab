Cell[BoxData[
 RowBox[{"rEFFTAB", "//", "Factor"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"a64c7058-229c-480d-8709-f9f77d2144f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "r2", ",", 
   FractionBox[
    RowBox[{"r2", " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"3", " ", "\[Alpha]"}]}], ")"}]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.991506488950993*^9, 3.991506508321413*^9}, 
   3.9923523664020567`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"d1ffa850-3250-4617-afb4-e3915ac1605d"]
}, Open  ]],

Cell["\<\
Check, but with two crossover events, the average number of matches is 1/2 \
(in the absence of bias):\
\>", "Text",
 CellChangeTimes->{{3.9913277031649027`*^9, 
  3.991327739561007*^9}},ExpressionUUID->"fa2e46d4-4733-4587-8844-\
cef0356b3daf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "[", 
      RowBox[{"[", "i", "]"}], "]"}], 
     RowBox[{"Mean", "[", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
        RowBox[{"tabMATCHES", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], "}"}]}], "]"}], "//", 
  "Total"}]], "Input",
 CellChangeTimes->{{3.9913274948538218`*^9, 3.991327650325799*^9}, {
  3.9913276998089314`*^9, 3.991327700723856*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"c734ba6b-4bf5-4e4e-a0a2-a53b84eef7d7"],

Cell[BoxData[
 FractionBox["1", "2"]], "Output",
 CellChangeTimes->{{3.991327497619615*^9, 3.991327524713953*^9}, {
   3.9913275845727043`*^9, 3.9913276185804996`*^9}, 3.991327652720624*^9, 
   3.9913277012841873`*^9, 3.9923523664065742`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"83dfe486-39c1-45e6-aab4-1c74de53bb94"]
}, Open  ]],

Cell["\<\
where r2 is some function relating the recombination rate r to the chance of \
two recombination events. 
For example, if there were only 0 or two recombination events (never one), \
then the average observed recombination rate between markers (no bias) would \
be p0*0+p2*1/2. Setting p2=1-p0, we would have to have p2 = 2 r (just like \
with one crossover) to have an average recombination rate in the region of r.\
\
\>", "Text",
 CellChangeTimes->{{3.991327399958219*^9, 3.99132747980583*^9}, {
  3.991327805048751*^9, 
  3.9913279319445868`*^9}},ExpressionUUID->"be2adbac-c08c-41b3-b8b1-\
7ad49a96651f"],

Cell["\<\
If there was a 2r chance of 2 crossovers (so that each chromatid has a chance \
of r of having the markers not match) and otherwise no recombination events, \
then bias will change this by an amount:\
\>", "Text",
 CellChangeTimes->{{3.9913255906041403`*^9, 3.991325644618166*^9}, {
  3.991326173971485*^9, 3.991326179124524*^9}, {3.991328064583829*^9, 
  3.991328087444222*^9}},ExpressionUUID->"f8bf448f-dee9-428c-b1fe-\
85b11640f80e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEFF2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "*", "rEFFTAB"}], "/.", 
     RowBox[{"r2", "->", 
      RowBox[{"2", " ", "r"}]}]}], "//", "Total"}], "//", 
   "Factor"}]}]], "Input",
 CellChangeTimes->{{3.991327363048202*^9, 3.991327383811064*^9}, {
  3.991327982222476*^9, 3.991328011326496*^9}, {3.991328045703308*^9, 
  3.99132804726472*^9}, {3.991328218605659*^9, 3.9913282199647923`*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"37472a64-7ff7-429a-9063-9408966a9e84"],

Cell[BoxData[
 FractionBox[
  RowBox[{"r", " ", 
   RowBox[{"(", 
    RowBox[{"4", "+", 
     RowBox[{"5", " ", "\[Alpha]"}]}], ")"}]}], 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]], "Output",
 CellChangeTimes->{
  3.9913271365405273`*^9, {3.991327348820251*^9, 3.991327384272263*^9}, {
   3.991327990974868*^9, 3.99132801575552*^9}, 3.991328049218848*^9, 
   3.991328094690332*^9, 3.9913282209357777`*^9, 3.991506783523419*^9, 
   3.9923523664267406`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"40f0b003-8164-4c6a-896d-b17a546d89ae"]
}, Open  ]],

Cell["In the absence of a bias:", "Text",
 CellChangeTimes->{{3.9913257819296*^9, 
  3.9913257900935373`*^9}},ExpressionUUID->"d48448a5-5f93-46e4-9925-\
bad10ace775c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"%", "/.", 
  RowBox[{"\[Alpha]", "->", "0"}]}]], "Input",
 CellChangeTimes->{{3.991325792337768*^9, 3.99132579592723*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"bc816b88-7c7f-477e-8831-f94a342772e8"],

Cell[BoxData["r"], "Output",
 CellChangeTimes->{3.9913257966346817`*^9, 3.991325884950636*^9, 
  3.9913261449154663`*^9, 3.991328102240513*^9, 3.992352366431302*^9},
 CellLabel->"Out[24]=",ExpressionUUID->"8c50465f-da43-4697-9572-1b38b8650413"]
}, Open  ]],

Cell["\<\
In the limit, as \[Alpha] goes to infinity, then the max rEFF would be 5r/4, \
which will rise above one for r values >0.8.  This (dashed) is much less \
biased than with a single cross-over (solid black), even though we have \
allowed an additive rise in preference with the number of crossover events.\
\>", "Text",
 CellChangeTimes->{{3.991326257484338*^9, 3.9913262770593643`*^9}, {
  3.991326327501597*^9, 3.9913263502272367`*^9}, {3.9913281197471743`*^9, 
  3.99132817083109*^9}, {3.991328283370219*^9, 
  3.991328292092347*^9}},ExpressionUUID->"12ed683e-34ac-4a0a-86b5-\
f21c675fffe0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Black"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"rEFF2", "/", "r"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "0", ",", "5"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<rEFF/r\>\""}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
