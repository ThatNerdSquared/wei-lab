Cell[BoxData[
 RowBox[{"configuration", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"n", "-", "k", "-", "i"}], ",", "j", ",", 
        RowBox[{"k", "-", "j"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", 
        RowBox[{"n", "-", "k"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "k"}], "}"}]}], "]"}], ",", "2"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9899498360480843`*^9, 3.9899498598303843`*^9}, {
  3.989949912998665*^9, 3.9899499153258247`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"9c5e8ee3-008f-4101-9d42-a603e8334d42"],

