}, Open  ]],

Cell["\<\
In the limit, as \[Alpha] goes to infinity, then the max rEFF would be 2r, \
which will rise above one for r values >0.25.\
\>", "Text",
 CellChangeTimes->{{3.991326257484338*^9, 3.9913262770593643`*^9}, {
  3.991326327501597*^9, 
  3.9913263502272367`*^9}},ExpressionUUID->"59feef3b-fbea-4645-b183-\
d83c6b15bbb3"],

Cell["So relative to the expected recombination rat ", "Text",
 CellChangeTimes->{{3.99132615867768*^9, 
  3.991326170795306*^9}},ExpressionUUID->"bfd15bbf-e276-485a-8dfe-\
ecdf272c1f5d"],

