Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  FractionBox["4", 
   RowBox[{"4", " ", "+", " ", 
    RowBox[{"2", "*", "n", "*", "\[Alpha]"}]}]], "*", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"\[Alpha]", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "*", "j"}], " ", "+", " ", "1"}], ")"}]}]}], ")"}], "*", 
     SuperscriptBox["2", 
      RowBox[{"-", "n"}]], " ", 
     RowBox[{"Binomial", "[", 
      RowBox[{"n", ",", 
       RowBox[{"1", "+", 
        RowBox[{"2", " ", "j"}]}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", " ", "0", ",", " ", 
      FractionBox[
       RowBox[{"n", "-", "1"}], "2"]}], "}"}]}], "]"}]}]], "Input",
