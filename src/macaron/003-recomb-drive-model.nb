Cell["\<\
define an expression for the body of the expectation summation:\
\>", "Text",
 CellChangeTimes->{{3.994350999776092*^9, 
  3.9943510094499407`*^9}},ExpressionUUID->"1e893f32-3b68-488c-8060-\
2d8c43f2f639"],

Cell[BoxData[
 RowBox[{
  RowBox[{"innersum", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"additiveReffOddN", "[", "x", "]"}], "*", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"PoissonDistribution", "[", "\[Lambda]", "]"}], ",", " ", 
       "x"}], "]"}], ",", " ", 
     RowBox[{"x", " ", ">=", " ", "0"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.994349959281959*^9, 3.9943499655985403`*^9}, 
   3.994350137175407*^9},
 CellLabel->
  "In[109]:=",ExpressionUUID->"41bbfc00-495a-4f71-8e63-db2abda1cada"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"innersum", "[", "x", "]"}]], "Input",
 CellChangeTimes->{{3.994350160061489*^9, 3.994350162328059*^9}},
 CellLabel->
  "In[110]:=",ExpressionUUID->"493ac401-6f88-43dc-b4d7-931976cb1a31"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", "\[Lambda]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "x"}], ")"}], " ", "\[Alpha]"}]}], ")"}], " ", 
   SuperscriptBox["\[Lambda]", "x"]}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"4", "+", 
     RowBox[{"2", " ", "x", " ", "\[Alpha]"}]}], ")"}], " ", 
   RowBox[{"x", "!"}]}]]], "Output",
 CellChangeTimes->{3.994350162796302*^9, 3.995633215317281*^9, 
  3.995635378046072*^9},
 CellLabel->
  "Out[110]=",ExpressionUUID->"bed99921-a21b-472b-8bed-4973f22c50a9"]
}, Open  ]],

