Cell["With exactly two crossover events, the chromatid states are:", "Text",
 CellChangeTimes->{{3.9913253734242*^9, 3.9913253858957977`*^9}, {
  3.991327391655076*^9, 
  3.991327394603837*^9}},ExpressionUUID->"6c3d2e5a-1875-4841-a275-\
91c6522caa88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabEVENTS", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "crossover", " ", "events", " ", "between", " ", 
    "the", " ", "ends"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabMATCHES", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Whether", " ", "markers", " ", "match", " ", "at", " ", "the", " ", 
    "ends", " ", 
    RowBox[{"(", 
     RowBox[{"0", "=", "no"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"tabCOUNTS", "/", 
    RowBox[{"Total", "[", "tabCOUNTS", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991325321537078*^9, 3.991325445634583*^9}, {
  3.991326682392687*^9, 3.991326784415893*^9}, {3.9913268427012167`*^9, 
  3.991326853518496*^9}, {3.991326892026586*^9, 3.9913269183883133`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"ea1736b0-390e-4656-880c-ebd03448dd0f"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ii", "=", "1"}], ";", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"{", "}"}]}]}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tabBIAS", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
       RowBox[{
        RowBox[{"tabEVENTS", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
        RowBox[{
         RowBox[{"tabEVENTS", "[", 
          RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], "]"}]]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"temp", "=", 
     RowBox[{
      RowBox[{"tabBIAS", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
         RowBox[{"tabMATCHES", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}], "//", "Total"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"rEFFTAB", ",", 
       RowBox[{"r2", "*", "temp"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.991326936738636*^9, 3.9913270292006807`*^9}, {
  3.991327125717301*^9, 3.991327129528275*^9}, {3.9913273421960707`*^9, 
  3.991327346612061*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"2662df06-487d-4a9e-8e0a-1d0f2e8566d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEFFTAB", "//", "Factor"}]], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"fc3bc945-d241-4390-8396-937a8bc44751"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "r2", ",", 
   FractionBox[
    RowBox[{"r2", " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"3", " ", "\[Alpha]"}]}], ")"}]}], 
    RowBox[{"4", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.992352366582141*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"002d6ffb-69cf-43ec-bb48-4affc4c0e006"]
}, Open  ]],

Cell["\<\
Check, but with two crossover events, the average number of matches is 1/2 \
(in the absence of bias):\
\>", "Text",
 CellChangeTimes->{{3.9913277031649027`*^9, 
  3.991327739561007*^9}},ExpressionUUID->"efd0e7a6-f68b-4ecc-a2f7-\
22cf3fb487ab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "[", 
      RowBox[{"[", "i", "]"}], "]"}], 
     RowBox[{"Mean", "[", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
        RowBox[{"tabMATCHES", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], "}"}]}], "]"}], "//", 
  "Total"}]], "Input",
 CellChangeTimes->{{3.9913274948538218`*^9, 3.991327650325799*^9}, {
  3.9913276998089314`*^9, 3.991327700723856*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"1563c5b4-c722-48a9-95e4-ed52ac7c54da"],

Cell[BoxData[
 FractionBox["1", "2"]], "Output",
 CellChangeTimes->{{3.991327497619615*^9, 3.991327524713953*^9}, {
   3.9913275845727043`*^9, 3.9913276185804996`*^9}, 3.991327652720624*^9, 
   3.9913277012841873`*^9, 3.992352366586297*^9},
 CellLabel->"Out[33]=",ExpressionUUID->"bc69b307-d3a8-4d99-9e26-5bfc21049ead"]
}, Open  ]],

Cell["\<\
where r2 is some function relating the recombination rate r to the chance of \
two recombination events. 
For example, if there were only 0 or two recombination events (never one), \
then the average observed recombination rate between markers (no bias) would \
be p0*0+p2*1/2. Setting p2=1-p0, we would have to have p2 = 2 r (just like \
with one crossover) to have an average recombination rate in the region of r.\
\
\>", "Text",
 CellChangeTimes->{{3.991327399958219*^9, 3.99132747980583*^9}, {
  3.991327805048751*^9, 
  3.9913279319445868`*^9}},ExpressionUUID->"37ef093e-bd6c-45da-bb64-\
46fc37ee3026"],

Cell["\<\
If there was a 2r chance of 2 crossovers (so that each chromatid has a chance \
of r of having the markers not match) and otherwise no recombination events, \
then bias will change this by an amount:\
\>", "Text",
 CellChangeTimes->{{3.9913255906041403`*^9, 3.991325644618166*^9}, {
  3.991326173971485*^9, 3.991326179124524*^9}, {3.991328064583829*^9, 
  3.991328087444222*^9}},ExpressionUUID->"cae39e76-ba01-4c58-92e4-\
c38b0685f753"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rEFF2", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"tabCOUNTS", "*", "rEFFTAB"}], "/.", 
     RowBox[{"r2", "->", 
      RowBox[{"2", " ", "r"}]}]}], "//", "Total"}], "//", 
   "Factor"}]}]], "Input",
 CellChangeTimes->{{3.991327363048202*^9, 3.991327383811064*^9}, {
  3.991327982222476*^9, 3.991328011326496*^9}, {3.991328045703308*^9, 
  3.99132804726472*^9}, {3.991328218605659*^9, 3.9913282199647923`*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"5b27c036-2bee-42fc-a687-706d01812853"],

Cell[BoxData[
 FractionBox[
  RowBox[{"r", " ", 
   RowBox[{"(", 
    RowBox[{"4", "+", 
     RowBox[{"5", " ", "\[Alpha]"}]}], ")"}]}], 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]]], "Output",
 CellChangeTimes->{
  3.9913271365405273`*^9, {3.991327348820251*^9, 3.991327384272263*^9}, {
   3.991327990974868*^9, 3.99132801575552*^9}, 3.991328049218848*^9, 
   3.991328094690332*^9, 3.9913282209357777`*^9, 3.992352366590294*^9},
 CellLabel->"Out[34]=",ExpressionUUID->"ff52aba8-d917-422c-a49a-3e26d691e11f"]
}, Open  ]],

Cell["In the absence of a bias:", "Text",
 CellChangeTimes->{{3.9913257819296*^9, 
  3.9913257900935373`*^9}},ExpressionUUID->"5e94d619-5694-4535-8278-\
763d8fee6f8d"],

