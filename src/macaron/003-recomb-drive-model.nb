Cell[CellGroupData[{

Cell["for multiplicative \[Alpha] [WIP]", "Subsubsection",
 CellChangeTimes->{{3.9941781187886066`*^9, 3.994178124190864*^9}, {
  3.994352203253572*^9, 
  3.994352203941279*^9}},ExpressionUUID->"e961b2d3-a19b-4231-bf90-\
ba65937bea2c"],

Cell[TextData[{
 "we use the same definitions of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "X_i | N = n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7bdda61-9463-4c74-a845-5e4cd0e65cff"],
 " as in the previous part. once again, the weighted-recombinant-state can be \
expressed as a random variable:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["Y", "TI"], 
              StyleBox["i", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
             RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
           SubscriptBox[
            StyleBox["X", "TI"], 
            StyleBox["i", "TI"]]], 
          RowBox[{
            UnderoverscriptBox["\[Sum]", 
             RowBox[{
               StyleBox["j", "TI"], "\[LongEqual]", "1"}], "4", 
             LimitsPositioning -> True], 
            SuperscriptBox[
             RowBox[{"(", 
               RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["j", "TI"]]]}]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["X", "TI"], 
              StyleBox["i", "TI"]], "  ", "mod", "2"}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(Y_i | N = n) = \\frac{(1 + \\alpha)^{X_i}}{\\sum_{j=1}^4(1 + \
\\alpha)^{X_j}} (X_i \\mod 2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b87df84-6dd2-464f-8799-00a2df1f0729"],
 ".\nas before, the recombinant state of the tetrad is just a sum of these:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "mult"], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", "1", "4", LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["Y", "TI"], 
          StyleBox["i", "TI"]], "|", 
         StyleBox["N", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "M_{\\text{mult}} | N = n = \\sum_1^4 Y_i | N = n", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0639e7b-2163-4214-9f37-50cc1ae9174d"],
 ".\nand ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["r", "TI"], "eff", 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "r_{\\text{eff}}^m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1bbde43c-f78e-4fee-b846-49314d9fb030"],
 " is defined similarly to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ab168ea-971f-4d79-b8d0-669414c807f7"],
 ":\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["r", "TI"], "eff", 
          StyleBox["m", "TI"]], "\[LongEqual]", 
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["M", "TI"], "mult"], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "r_{\\text{eff}}^m = \\mathbb{E}[M_{\\text{mult}} | N = n]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ede3758f-86d2-489d-b001-92058036cd47"],
 "."
}], "Text",
 CellChangeTimes->{{3.9955437642577343`*^9, 3.995543821418991*^9}, 
   3.995550483157002*^9, {3.99555056973562*^9, 3.995550581614872*^9}, 
   3.995550636278804*^9, {3.995554275817156*^9, 3.9955543053377953`*^9}, 
   3.995554370603532*^9},ExpressionUUID->"61f8e7bc-7e22-4f5f-8e21-\
1fdd1a66a32d"],

Cell[TextData[{
 "by linearity of expectation,\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], "eff"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["Y", "TI"], 
              StyleBox["i", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "r_{\\text {eff}} = \\sum_{i=1}^4\\mathbb {E}[Y_i | N = n]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd9a3746-c716-4a23-886c-8a487d9f4c1c"],
 "\nbut unlike the additive case, it\[CloseCurlyQuote]s more complicated to \
determine ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["E", FontSlant -> "Plain"], 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["Y", "TI"], 
              StyleBox["i", "TI"]], "|", 
             StyleBox["N", "TI"], "\[LongEqual]", 
             StyleBox["n", "TI"]}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\mathbb {E}[Y_i| N = n]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "635a37e8-b4fd-4ab7-af2c-754d70ad059e"],
 " as each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Y", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "Y_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29bfe563-30d6-4506-82a8-27196581e037"],
 " is dependent on other ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["X", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "X_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2fa45dc3-abc3-481a-aaf5-9e3ae5a06db5"],
 "s (from the denominator). then to find this expectation, we need the joint \
distribution of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "42992fed-3682-4601-acd2-e93d16f0e2db"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["S", "TI"], ":", "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", "1", "4", LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "S := \\sum_1^4 T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f49da5cd-b9b3-4b9e-9c19-ded24310029a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          SubscriptBox[
           StyleBox["X", "TI"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i = (1 + \\alpha)^{X_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cbc35a5-4efc-419b-9613-15256e064277"],
 ".\nwe can first subtract out ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["T", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i = k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67e7648b-fd65-4233-82d9-24d1a7f695d3"],
 " from the sum:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["s", "TI"], "-", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(T_i = k, S = s) = P(T_i = k, T_j + T_k + T_l = s - k)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f868a5db-0696-4e9f-906d-9ecaca1ccadd"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"], ",", 
         StyleBox["l", "TI"], "\[Element]", 
         RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "j, k, l \\in \\{ 1, 2, 3, 4 \\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3463932-24dd-4f42-9ea4-e1e09f63b071"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["j", "TI"], ",", 
         StyleBox["k", "TI"], ",", 
         StyleBox["l", "TI"], "\[NotEqual]", 
         StyleBox["i", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "j, k, l \\neq i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9279e29e-6860-43c4-84d9-ef8d4967b778"],
 ".\nassume WLOG that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox[
          StyleBox["X", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "X_i, X_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0090d864-b090-4236-9ecb-401255216eba"],
 " are sisters. then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8755a562-b691-42f6-8398-33942f707afe"],
 " is fully determined by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0b676a0-1b1c-4b7b-8295-ee1f0612d755"],
 ": it is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
        RowBox[{
          StyleBox["n", "TI"], "-", 
          SubscriptBox["log", 
           RowBox[{"1", "+", "\[Alpha]"}]], 
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["i", "TI"]], ")"}]}]], TraditionalForm], "errors" -> {},
      "input" -> "(1+\\alpha)^{n - \\log_{1+\\alpha}(T_i)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2c53a44-6b4a-43f5-9dd0-463d33ee1c35"],
 ". then:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["s", "TI"], "-", 
             StyleBox["k", "TI"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
                RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
              RowBox[{
                StyleBox["n", "TI"], "-", 
                SubscriptBox["log", 
                 RowBox[{"1", "+", "\[Alpha]"}]], 
                RowBox[{"(", 
                  StyleBox["k", "TI"], ")"}]}]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P(T_i = k, S = s) = P(T_i = k, T_k + T_l = s - k - (1 + \\alpha)^{n - \
\\log_{1+\\alpha}(k)})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5abd789-8ed1-4940-b48f-37cc805a6e0b"],
 ".\nlet ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["s", "TI"], "-", 
         StyleBox["k", "TI"], "-", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
          RowBox[{
            StyleBox["n", "TI"], "-", 
            SubscriptBox["log", 
             RowBox[{"1", "+", "\[Alpha]"}]], 
            RowBox[{"(", 
              StyleBox["k", "TI"], ")"}]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "b = s - k - (1 + \\alpha)^{n - \\log_{1+\\alpha}(k)}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "48846646-3585-43d0-b708-b2793b894422"],
 " for notational simplicity.\nthen by the chain rule:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"], ",", 
             StyleBox["S", "TI"], "\[LongEqual]", 
             StyleBox["s", "TI"]}], ")"}], "\[LongEqual]", 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["k", "TI"]], "+", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["l", "TI"]], "\[LongEqual]", 
             StyleBox["b", "TI"], "|", 
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}], 
         StyleBox["P", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["T", "TI"], 
              StyleBox["i", "TI"]], "\[LongEqual]", 
             StyleBox["k", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "P(T_i = k, S = s) = P(T_k + T_l = b | T_i = k)P(T_i = k)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd08de3e-035d-4914-837e-0d8fbc2bd08e"],
 "."
}], "Text",
 CellChangeTimes->{{3.995554308639661*^9, 3.9955544830373697`*^9}, {
   3.995554681378675*^9, 3.99555475569729*^9}, {3.995554951802403*^9, 
   3.995555045576806*^9}, {3.9955550799488487`*^9, 3.9955550905262938`*^9}, {
   3.99555516955805*^9, 3.99555522459378*^9}, 3.995555690532028*^9, {
   3.995561172269113*^9, 3.9955611758723583`*^9}, {3.9955612632292356`*^9, 
   3.995561263359736*^9}, {3.995561339837964*^9, 3.995561358524332*^9}, {
   3.995562728007696*^9, 
   3.9955627435054893`*^9}},ExpressionUUID->"dd4d1cd8-ea40-4f43-afcb-\
f4e36a52070a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pTi", "[", "k_", "]"}], ":=", 
  RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"1", "+", "\[Alpha]"}], ",", " ", "k"}], "]"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"0", " ", "<=", " ", 
      RowBox[{"Log", "[", 
       RowBox[{
        RowBox[{"1", "+", "\[Alpha]"}], ",", " ", "k"}], "]"}], " ", "<=", 
      " ", "n"}], "}"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.995563906794239*^9, 3.995563912424055*^9}, {
   3.9955650800091133`*^9, 3.995565131364291*^9}, {3.995565175095233*^9, 
   3.995565184344558*^9}, 
   3.995565445890785*^9},ExpressionUUID->"0c1adf59-208e-4f84-8c1e-\
5152544fefbf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"psumTiTj", "[", "sij_", "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Sum", "[", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Simplify", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}], "k"], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
       RowBox[{"n", "-", "k"}]]}], ")"}], 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"BinomialDistribution", "[", 
       RowBox[{"n", ",", " ", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", " ", "k"}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"0", " ", "<=", " ", "k", "<=", "n"}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.995563891453946*^9, 3.995563933606666*^9}, {
   3.995564929975951*^9, 3.995564933496461*^9}, {3.99556503163538*^9, 
   3.995565035260851*^9}, 3.995565187126055*^9, {3.995565449068265*^9, 
   3.9955654698936787`*^9}},ExpressionUUID->"c69f7746-2d88-4632-8c3a-\
feb3be9d3c35"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Alpha]"}], ")"}], "x"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
      RowBox[{"n", "-", "x"}]]}], "==", "d"}], ",", " ", "x"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.995563864378707*^9, 3.995563890007958*^9}, {
  3.99556549577639*^9, 3.995565546773645*^9}},
 CellLabel->
  "In[378]:=",ExpressionUUID->"c125c63b-c678-4d7c-8cc4-feae0143ba01"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     TemplateBox[{
       FractionBox[
        RowBox[{
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
            TemplateBox[{"1"}, "C"]}], "+", 
          RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{
               RowBox[{"d", " ", 
                 SqrtBox[
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
                   RowBox[{"-", "n"}]]]}], "-", 
               SqrtBox[
                RowBox[{
                  RowBox[{"-", "4"}], "+", 
                  RowBox[{
                    SuperscriptBox["d", "2"], " ", 
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
                    RowBox[{"-", "n"}]]}]}]]}], 
             RowBox[{"2", " ", 
               SqrtBox[
                SuperscriptBox[
                 RowBox[{"(", 
                   RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
                 RowBox[{"-", "n"}]]]}]], "]"}]}], 
        RowBox[{"Log", "[", 
          RowBox[{"1", "+", "\[Alpha]"}], "]"}]], 
       RowBox[{
         TemplateBox[{"1"}, "C"], "\[Element]", 
         TemplateBox[{}, "Integers"]}]},
      "ConditionalExpression"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     TemplateBox[{
       FractionBox[
        RowBox[{
          RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Pi]", " ", 
            TemplateBox[{"1"}, "C"]}], "+", 
          RowBox[{"Log", "[", 
            FractionBox[
             RowBox[{
               RowBox[{"d", " ", 
                 SqrtBox[
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"1", "+", "\[Alpha]"}], ")"}], 
                   RowBox[{"-", "n"}]]]}], "+", 
