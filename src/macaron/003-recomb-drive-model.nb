Cell[CellGroupData[{

Cell["calculating E[RF] given N COs", "Subsection",
 CellChangeTimes->{{3.9915141504682417`*^9, 
  3.9915141926136007`*^9}},ExpressionUUID->"c3a69fce-a5f2-47fd-a7eb-\
5f05ae28fc82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"possiblepairs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"expectedrf", "[", "N_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"numpossible", " ", "=", " ", 
       RowBox[{
        RowBox[{"4", "^", "N"}], " ", "*", " ", 
        RowBox[{"N", "!"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"leaves", " ", "=", " ", 
       RowBox[{"buildCOPairTable", "[", "N", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Permutations", "[", "#", "]"}], "&"}], " ", "/@", " ", 
       "leaves"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Scan", "[", "leaves", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991514195209303*^9, 3.9915142277724524`*^9}, {
