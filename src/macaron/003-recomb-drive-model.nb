Cell[CellGroupData[{

Cell["With two crossovers", "Subsubsection",
 CellChangeTimes->{{3.991326567260683*^9, 
  3.9913265798943243`*^9}},ExpressionUUID->"a0f0d197-ba10-4680-a066-\
1dce237bd79a"],

Cell["With exactly two crossover events, the chromatid states are:", "Text",
 CellChangeTimes->{{3.9913253734242*^9, 3.9913253858957977`*^9}, {
  3.991327391655076*^9, 
  3.991327394603837*^9}},ExpressionUUID->"b8626359-2063-4b56-a601-\
10654ab10a75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabEVENTS", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "2", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "1", ",", "1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "crossover", " ", "events", " ", "between", " ", 
    "the", " ", "ends"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabMATCHES", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
  " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Whether", " ", "markers", " ", "match", " ", "at", " ", "the", " ", 
    "ends", " ", 
    RowBox[{"(", 
     RowBox[{"0", "=", "no"}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"{", 
    RowBox[{"4", ",", "4", ",", "8"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tabCOUNTS", "=", 
   RowBox[{"tabCOUNTS", "/", 
    RowBox[{"Total", "[", "tabCOUNTS", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.991325321537078*^9, 3.991325445634583*^9}, {
   3.991326682392687*^9, 3.991326784415893*^9}, {3.9913268427012167`*^9, 
   3.991326853518496*^9}, {3.991326892026586*^9, 3.9913269183883133`*^9}, 
   3.991502166570822*^9, {3.9915054296848583`*^9, 3.99150542971484*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"09818c2c-facb-4014-9344-82f4e6990b43"],

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"ii", "=", "1"}], ";", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"{", "}"}]}]}], ",", 
   RowBox[{"ii", "\[LessEqual]", 
    RowBox[{"Length", "[", "tabCOUNTS", "]"}]}], ",", 
   RowBox[{"ii", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tabBIAS", "=", 
     FractionBox[
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
       RowBox[{
        RowBox[{"tabEVENTS", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
        RowBox[{
         RowBox[{"tabEVENTS", "[", 
          RowBox[{"[", "ii", "]"}], "]"}], "*", "\[Alpha]"}]}], "]"}]]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"temp", "=", 
     RowBox[{
      RowBox[{"tabBIAS", "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
         RowBox[{"tabMATCHES", "[", 
          RowBox[{"[", "ii", "]"}], "]"}]}], ")"}]}], "//", "Total"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"rEFFTAB", "=", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"rEFFTAB", ",", 
       RowBox[{"r2", "*", "temp"}]}], "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellChangeTimes->{{3.991326936738636*^9, 3.9913270292006807`*^9}, {
