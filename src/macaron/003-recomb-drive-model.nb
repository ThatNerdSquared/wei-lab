  3.9923705438069267`*^9}, {3.99237061147582*^9, 3.992370675630467*^9}, {
  3.992370897245565*^9, 3.992370916775098*^9}},
 CellLabel->
  "In[243]:=",ExpressionUUID->"9fd06a6e-8036-4fa6-b18d-0977a9e34919"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"swapelems", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}], ",", 
