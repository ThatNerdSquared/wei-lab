Cell["\<\
given a spatial ordering, we want to be able to compute, for a given CO-pair, \
how many spatially-later COs will be placed before it (temporally).\
\>", "Text",
 CellChangeTimes->{{3.992353185528242*^9, 3.992353193402657*^9}, {
  3.992353270133541*^9, 
  3.992353304443713*^9}},ExpressionUUID->"e07e4265-eed4-4c12-91cc-\
3a5fe894b96f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"testSpatOrd", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "4"}], "}"}], ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
