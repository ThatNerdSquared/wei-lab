 RowBox[{"TransformedDistribution", "[", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "\[Alpha]"}], ")"}], "x"], ",", " ", 
   RowBox[{"x", "\[Distributed]", 
    RowBox[{"BinomialDistribution", "[", 
     RowBox[{"n", ",", " ", 
      RowBox[{"1", "/", "2"}]}], "]"}]}]}], "]"}]], "Input",
