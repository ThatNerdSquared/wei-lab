Cell["\<\
we define a function to calculate the match state of a given tetrad:\
\>", "Text",
 CellChangeTimes->{{3.992437700418131*^9, 
  3.9924377294060497`*^9}},ExpressionUUID->"08fe1e69-38f5-45bc-858a-\
cef40e702dc0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"calculateMatchState", "[", "tetrad_", "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
    RowBox[{"Equal", ",", " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"tetrad", "[", "\"\<Elements\>\"", "]"}], " ", "//", " ", 
        "First"}], ",", " ", 
       RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "]"}], " ", "/.", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"True", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"False", " ", "->", "0"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.992437797000396*^9, 3.992437804960453*^9}, {
  3.992438202853425*^9, 3.992438232532197*^9}, {3.992438427907971*^9, 
  3.992438446438197*^9}, {3.9924389161582117`*^9, 3.9924389654959583`*^9}},
