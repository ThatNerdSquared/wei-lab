   RowBox[{"--", 
    RowBox[{"-", "\n", 
     RowBox[{"2", " ", "--"}]}]}]}], "-", 
  RowBox[{
   RowBox[{".", 
    RowBox[{"--", 
     RowBox[{"-", "\n", "3"}]}]}], " ", 
   RowBox[{"xxx", ".", "xxx"}]}]}], "\n", 
 RowBox[{"4", " ", 
  RowBox[{"xxx", ".", "xxx"}]}]}], "Code",
