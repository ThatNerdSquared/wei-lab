   RowBox[{"(", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "-", 
     RowBox[{"tabMATCHES", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}], "//", "Total"}]], "Input",
 CellChangeTimes->{{3.99132566279348*^9, 3.991325695892681*^9}, {
   3.9913257420987883`*^9, 3.991325745455518*^9}, 3.991325880781013*^9, 
