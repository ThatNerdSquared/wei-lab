      RowBox[{"PoissonDistribution", "[", "\[Lambda]", "]"}], ",", " ", "k"}],
      "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "0", ",", " ", "20"}], "}"}]}], "]"}]}]], "Input",\

 CellChangeTimes->{{3.995630537248775*^9, 3.995630561602354*^9}, {
