Cell[TextData[{
 "however, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["d", "TI"], TraditionalForm], "errors" -> {}, "input" -> "d", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abc7d274-fd54-466a-94d9-507ba3917359"],
 " is symmetric over the domain we care about, so we can probably invert it \
only over half of the desired domain, and then double the probabilities."
}], "Text",
 CellChangeTimes->{{3.9956540084051647`*^9, 3.9956540235997953`*^9}, {
  3.995654197887197*^9, 3.995654233059374*^9}, {3.99572786367548*^9, 
  3.995727864644175*^9}},ExpressionUUID->"2b7fff6e-815e-44b6-85ec-\
2844d8f3ffcc"],

Cell[TextData[{
 "going to give up on this for now but might come back to it later if i find \
that working out ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["d", "TI"], "-1"], TraditionalForm], "errors" -> {}, "input" -> 
     "d^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3efaa3b7-0e09-4169-9aab-46dee9c2d8ef"],
 " is worth it for some reason. "
}], "Text",
 CellChangeTimes->{{3.995727865359397*^9, 
  3.99572789655221*^9}},ExpressionUUID->"0f644941-73c9-4d32-a543-\
ed3f6dbc4023"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["poisson-weighting", "Subsection",
 CellChangeTimes->{{3.994349312474059*^9, 
  3.994349318436092*^9}},ExpressionUUID->"9e924da1-e933-43eb-88c2-\
20aa58ed5a34"],

Cell[CellGroupData[{

Cell["for additive \[Alpha]", "Subsubsection",
 CellChangeTimes->{{3.9943494502626667`*^9, 
  3.994349453904615*^9}},ExpressionUUID->"d5b4ceb5-a0ff-4e33-8b2b-\
15f2209b9c49"],

Cell["using the expressions we found previously:", "Text",
 CellChangeTimes->{{3.994351784989737*^9, 
  3.994351788788541*^9}},ExpressionUUID->"dbf40447-1261-467a-a5c1-\
01370684c3d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"additiveReffEvenN", "[", "n", "]"}]], "Input",
 CellChangeTimes->{
  3.99434944904513*^9, {3.994351790678481*^9, 3.994351792292878*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"4768efed-7bed-45fe-9bad-f140d3ec017a"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     FractionBox["\[Alpha]", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"3", " ", "n", " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["n", "2"], " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.9943494557561493`*^9, 3.994351792715369*^9, 
  3.995633121401382*^9, 3.9956352840328913`*^9},
 CellLabel->
  "Out[103]=",ExpressionUUID->"35238681-83b3-4b76-b23e-d2bba2e49099"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"additiveReffOddN", "[", "n", "]"}]], "Input",
 CellChangeTimes->{{3.994349457086184*^9, 3.9943494590553837`*^9}},
 CellLabel->
  "In[104]:=",ExpressionUUID->"ebf4409f-0598-41b9-899b-3598e9b667e3"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}]}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.9943494595490227`*^9, 3.995633121409417*^9, 
  3.9956352840574636`*^9},
 CellLabel->
  "Out[104]=",ExpressionUUID->"4bb75198-b383-49e4-9c42-bb43b00ba678"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  TemplateBox[<|
   "InUUID" -> "4768efed-7bed-45fe-9bad-f140d3ec017a", "OutUUID" -> 
    "35238681-83b3-4b76-b23e-d2bba2e49099", "InUUIDOffset" -> 0, 
