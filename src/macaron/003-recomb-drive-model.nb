6884d4a4c49f"],

Cell["\<\
we first list all possible chromatid pairs that can participate in a CO:\
\>", "Text",
 CellChangeTimes->{{3.9920224974328537`*^9, 
  3.992022511414736*^9}},ExpressionUUID->"8b46d5bb-5a85-4366-aaed-\
7694f77cf427"],

Cell[BoxData[
 RowBox[{
  RowBox[{"possiblepairs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "4"}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.992022513303731*^9, {3.9920232187351513`*^9, 3.992023219381012*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"2b404649-ac93-4a7f-8c8b-78c72af20fcc"],

Cell[CellGroupData[{

Cell["weights from drive", "Subsection",
 CellChangeTimes->{{3.99131468065956*^9, 3.9913147117439632`*^9}, {
  3.991325317563283*^9, 
  3.991325318846671*^9}},ExpressionUUID->"d86dfcc4-97ea-44f2-a6ce-\
1a9c3a04f6f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"w\[Alpha]", "[", "x_", "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"1", "+", " ", 
     RowBox[{"x", "*", "\[Alpha]"}]}], 
    RowBox[{"Total", "[", 
     RowBox[{"1", " ", "+", " ", 
      RowBox[{"x", "*", "\[Alpha]"}]}], "]"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.991500708401581*^9, 3.991500709063546*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"edc404d4-2e5d-48fb-90ec-9f847f789302"]
}, Open  ]],

Cell[CellGroupData[{

Cell["generating all possible CO-pair sequences of length N", "Subsection",
 CellChangeTimes->{{3.9920222949533443`*^9, 
  3.992022317541313*^9}},ExpressionUUID->"7e0dc8ad-5bd2-4f8d-8711-\
2ffb44edb350"],

Cell["\<\
create a function that attaches a given chromatid pair to each of a list of \
decision tree \[OpenCurlyDoubleQuote]branches\[CloseCurlyDoubleQuote]:\
\>", "Text",
 CellChangeTimes->{{3.992025384515862*^9, 3.99202541017214*^9}, {
  3.992097672443571*^9, 
  3.992097699981142*^9}},ExpressionUUID->"ea9ef206-fe92-4d48-960f-\
62371d0e0248"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildBranch", "[", 
   RowBox[{"pair_", ",", "branches_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "pair", "}"}], ",", " ", "#"}], "]"}], "&"}], " ", " ", "/@",
    " ", "branches"}]}]], "Input",
 CellChangeTimes->{{3.992025418512841*^9, 3.992025527143056*^9}, {
   3.992091420686508*^9, 3.9920914228485003`*^9}, {3.992092864219198*^9, 
   3.992092865603374*^9}, {3.9920931443721247`*^9, 3.992093147310836*^9}, {
   3.992093357922523*^9, 3.9920933645973043`*^9}, {3.992094677862221*^9, 
   3.9920946850556107`*^9}, {3.9920955332798357`*^9, 3.992095549752468*^9}, {
   3.992095658245652*^9, 3.9920956695445004`*^9}, 3.992096209870091*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"49a96e5f-54bb-414b-a477-f8e42d1b741f"],

Cell["\<\
then for a given N COs, we recursively generate all possible chromatid pair \
sequences of length N:\
\>", "Text",
 CellChangeTimes->{{3.9920223205791187`*^9, 3.992022325411367*^9}, {
  3.992095610665395*^9, 3.9920956467975893`*^9}, {3.992096227279106*^9, 
  3.992096230680512*^9}, {3.992096398565515*^9, 
  3.99209642895055*^9}},ExpressionUUID->"8e1897ee-d223-4c66-9967-\
e8928a4afdca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"buildCOPairTable", "[", "N_", "]"}], " ", ":=", " ", 
  RowBox[{"If", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"N", "==", "0"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"{", "}"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"buildBranch", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"buildCOPairTable", "[", 
          RowBox[{"N", "-", "1"}], "]"}]}], "]"}], "&"}], " ", "/@", " ", 
      "possiblepairs"}], "\[IndentingNewLine]", "//", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "flatten", " ", "the", " ", "4", " ", "sublists", " ", "created"}], ",", 
     " ", 
     RowBox[{"1", " ", "per", " ", "pair"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
