Cell[CellGroupData[{

Cell["With one crossover", "Subsubsection",
 CellChangeTimes->{{3.991326567260683*^9, 
  3.991326570625909*^9}},ExpressionUUID->"e99851b9-3e58-4aad-9549-\
ba573bcb092e"],

Cell["With exactly one crossover event, the chromatid states are:", "Text",
 CellChangeTimes->{{3.9913253734242*^9, 
  3.9913253858957977`*^9}},ExpressionUUID->"3441103a-3f45-4c3a-b34d-\
797914cdba9a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tabEVENTS", "=", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Number", " ", "of", " ", "crossover", " ", "events", " ", "between", " ", 
    "the", " ", "ends"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tabMATCHES", "=", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Whether", " ", "markers", " ", "match", " ", "at", " ", "the", " ", 
    "ends", " ", 
    RowBox[{"(", 
     RowBox[{"0", "=", "no"}], ")"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.991325321537078*^9, 3.991325445634583*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"bc166312-5fba-4503-9103-73627e968736"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabBIAS", "=", 
  FractionBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
    RowBox[{
     RowBox[{"tabEVENTS", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", "\[Alpha]"}]}], 
   RowBox[{"Total", "[", 
