      "\"\[Alpha] = 0\"", "\"\[Alpha] = 1\"", "\"\[Alpha] = 2\"", 
       "\"\[Alpha] = 10\""}, "PointLegend", DisplayFunction -> (FormBox[
        StyleBox[
