Cell["\<\
we then define a function that, given a temporal and spatial sequence of \
CO-pairs, can generate a tetrad with haplotype configurations matching the \
given sequences:\
\>", "Text",
 CellChangeTimes->{{3.9920976325943193`*^9, 3.99209765059077*^9}, {
  3.992098011100193*^9, 3.9920980555224857`*^9}, {3.992370936389112*^9, 
  3.992370937198464*^9}},ExpressionUUID->"501492c2-774d-4a65-8a83-\
3bb868a226c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"placeCOs", "[", 
   RowBox[{"tempOrd_", ",", " ", "spatOrd_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tetrad", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"temphold", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}]}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tetrad", "[", 
      RowBox[{"\"\<Push\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
      "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"initialise", " ", "chromatid", " ", "haplotypes"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"numpops", " ", "=", " ", 
      RowBox[{"computeNumPops", "[", "spatOrd", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", " ", "<=", " ", 
        RowBox[{"Length", "[", "tempOrd", "]"}]}], ",", " ", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"currPair", " ", "=", " ", 
         RowBox[{
          RowBox[{"tempOrd", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "First"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"currTag", " ", "=", " ", 
         RowBox[{
          RowBox[{"tempOrd", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Last"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tetrad", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
           RowBox[{
            RowBox[{"temphold", "[", 
             RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ",", 
          " ", 
          RowBox[{"numpops", "[", 
           RowBox[{"[", "currTag", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "swap", " ", "haplotypes", " ", "of", " ", "strands", " ", 
          "involved", " ", "in", " ", "the", " ", "CO"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"newhaplotypes", " ", "=", " ", 
         RowBox[{"swapelems", "[", 
          RowBox[{
           RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}], ",", " ", 
           "currPair"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"tetrad", "[", 
         RowBox[{"\"\<Push\>\"", ",", " ", "newhaplotypes"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"temphold", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
            RowBox[{
             RowBox[{"swapelems", "[", 
              RowBox[{"#", ",", "currPair"}], "]"}], "&"}]}], " ", "//", " ", 
           
           RowBox[{
            RowBox[{"tetrad", "[", 
             RowBox[{"\"\<Push\>\"", ",", "#"}], "]"}], "&"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"numpops", "[", 
           RowBox[{"[", "currTag", "]"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "tetrad"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->CompressedData["
