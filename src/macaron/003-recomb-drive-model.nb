Cell[BoxData[
 RowBox[{"likelihood", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{"n", ",", "p"}], "]"}], ",", "k"}], "]"}], 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{"k", ",", "p"}], "]"}], ",", "j"}], "]"}], 
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"BinomialDistribution", "[", 
          RowBox[{
           RowBox[{"n", "-", "k"}], ",", "p"}], "]"}], ",", "i"}], "]"}]}], 
      " ", ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
