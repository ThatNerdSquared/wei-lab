 RowBox[{"{", 
  RowBox[{"0", ",", "r2", ",", 
   FractionBox[
    RowBox[{"r2", " ", 
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"3", " ", "\[Alpha]"}]}], ")"}]}], 
