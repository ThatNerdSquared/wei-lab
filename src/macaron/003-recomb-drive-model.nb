   "PercentRef"]}]], "Input",
 CellChangeTimes->{{3.994349461239711*^9, 3.994349465535036*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"bc7fd2ac-a407-4726-9e7a-14df19065a2f"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{"4", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], "+", 
      FractionBox["\[Alpha]", "2"], "+", 
      FractionBox["\[Alpha]", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "-", 
      FractionBox[
       RowBox[{"3", " ", "n", " ", "\[Alpha]"}], 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "+", 
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], " ", "\[Alpha]"}], 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], ")"}]}], 
   RowBox[{"4", "+", 
    RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]], "\[Equal]", 
  FractionBox[
   RowBox[{"4", " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], "+", 
      FractionBox["\[Alpha]", "2"], "+", 
      RowBox[{
       FractionBox["1", "4"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "2"}], "+", "n"}], ")"}], " ", "\[Alpha]"}]}], ")"}]}], 
   
   RowBox[{"4", "+", 
    RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]]}]], "Output",
 CellChangeTimes->{3.9943494660004168`*^9, 3.994351794467059*^9, 
  3.9956331214368677`*^9, 3.995635284121901*^9},
 CellLabel->
  "Out[105]=",ExpressionUUID->"55cb7671-f732-48fb-8fd0-5075fb8b78ae"]
}, Open  ]],

Cell["so both odd and even forms are equivalent.", "Text",
 CellChangeTimes->{{3.994350174596231*^9, 
  3.994350180885277*^9}},ExpressionUUID->"0c9a4f42-af45-4e77-a799-\
62f30bd4b2fd"],

Cell[TextData[{
 "we confirm that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "adf79621-465b-45d7-9ecf-0a566f4da7bd"],
 " | N = 1 does not equal 1/2:"
}], "Text",
 CellChangeTimes->{{3.994350925004375*^9, 3.9943509276319847`*^9}, {
  3.9943509581731243`*^9, 
  3.994350966735639*^9}},ExpressionUUID->"2895f479-cda5-4e52-921c-\
d6be34eb5639"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"additiveReffOddN", "[", "1", "]"}]], "Input",
 CellChangeTimes->{{3.99434950443347*^9, 3.994349512268733*^9}, {
  3.994349580647143*^9, 3.9943495840754747`*^9}, {3.9943503134796677`*^9, 
  3.9943503209131823`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"ee615872-aa9e-469e-aafa-5da83777f948"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{{3.994349507847804*^9, 3.994349512659154*^9}, 
   3.994349584639056*^9, {3.994350311466414*^9, 3.994350321174325*^9}, 
   3.995633121441039*^9, 3.995635284140036*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"273e0d83-f702-4950-89ce-ba45e4b5d6bb"]
}, Open  ]],

Cell[TextData[{
 "and then we poisson-weight ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["r", "TI"], "eff"], TraditionalForm], "errors" -> {}, 
     "input" -> "r_{\\text{eff}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30634dea-a748-462d-9c78-d8188cf2c0fb"],
 ":"
}], "Text",
 CellChangeTimes->{{3.994350929404814*^9, 
  3.994350954886067*^9}},ExpressionUUID->"bf027308-9269-40d6-afa4-\
9148d3b3a4c7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Expectation", "[", 
  RowBox[{
   RowBox[{"additiveReffOddN", "[", "k", "]"}], ",", " ", 
   RowBox[{"k", " ", "\[Distributed]", " ", 
    RowBox[{"PoissonDistribution", "[", "\[Lambda]", "]"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.99434947002427*^9, 3.994349485465626*^9}, {
  3.9943495904530783`*^9, 3.994349594977515*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"7fca68a5-9390-48de-8eb0-4091ece7de76"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "k"}], ")"}], " ", "\[Alpha]"}]}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "k", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{{3.994349486752425*^9, 3.994349491028658*^9}, 
   3.994349626536249*^9, 3.9956331683554296`*^9, 3.9956353310635757`*^9},
 CellLabel->
  "Out[107]=",ExpressionUUID->"8367b87c-4f80-4e4f-9146-712e9565c271"]
}, Open  ]],

Cell[TextData[{
 "doesn\[CloseCurlyQuote]t seem like what we\[CloseCurlyQuote]re supposed to \
be seeing? let\[CloseCurlyQuote]s try this more manually (without mathematica\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
 "Expectation"], "InlineCode",ExpressionUUID->
  "959e7742-dd84-4cd3-b3db-e5bc3bae517e"],
 " function):"
}], "Text",
 CellChangeTimes->{{3.9943496321360073`*^9, 3.9943496426103697`*^9}, {
  3.9943509703221807`*^9, 
  3.994350992173006*^9}},ExpressionUUID->"a204b105-46b8-4d67-94ce-\
43500d104157"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"PoissonDistribution", "[", "\[Lambda]", "]"}], ",", " ", "x"}], 
