Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", "2"], "+", 
     FractionBox["\[Alpha]", "2"], "+", 
     FractionBox["\[Alpha]", 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "-", 
     FractionBox[
      RowBox[{"3", " ", "n", " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["n", "2"], " ", "\[Alpha]"}], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}]}]]}], ")"}]}], 
  RowBox[{"4", "+", 
   RowBox[{"2", " ", "n", " ", "\[Alpha]"}]}]]], "Output",
 CellChangeTimes->{3.9943494557561493`*^9, 3.994351792715369*^9},
 CellLabel->
