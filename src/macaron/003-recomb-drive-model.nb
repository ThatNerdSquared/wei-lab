 RowBox[{
  RowBox[{"1", " ", "--"}], "-", 
  RowBox[{".", 
   RowBox[{"--", 
    RowBox[{"-", "\n", 
     RowBox[{"2", " ", "--"}]}]}]}], "-", 
  RowBox[{
   RowBox[{".", 
    RowBox[{"--", 
     RowBox[{"-", "\n", "3"}]}]}], " ", 
   RowBox[{"xxx", ".", "xxx"}]}]}], "\n", 
 RowBox[{"4", " ", 
  RowBox[{"xxx", ".", "xxx"}]}]}], "Code",
 CellChangeTimes->{{3.9913179971838093`*^9, 3.991317997883937*^9}, {
