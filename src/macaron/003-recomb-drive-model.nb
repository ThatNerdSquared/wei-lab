Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"tabBIAS", "=", 
  FractionBox[
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "+", 
    RowBox[{
     RowBox[{"tabEVENTS", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "*", "\[Alpha]"}]}], 
