Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", "\[Lambda]"}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
