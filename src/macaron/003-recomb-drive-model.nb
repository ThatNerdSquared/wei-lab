Cell["\<\
this makes sense - once you get to higher \[Lambda], more \
\[OpenCurlyDoubleQuote]meaningful\[CloseCurlyDoubleQuote] probabilities are \
getting truncated (\[Lambda] closer to 20, then distribution is roughly \
centred close to 20, so more and more of the distribution gets cut off), so \
the mean of our normalised poisson becomes smaller and smaller compared to \
the actual poisson mean.\
\>", "Text",
 CellChangeTimes->{{3.995634437703486*^9, 3.995634490710195*^9}, {
  3.995645752917787*^9, 
  3.995645770227091*^9}},ExpressionUUID->"ab9cf848-6055-46ec-8312-\
6fae1f2b2ccd"],

Cell[TextData[{
 "ignoring this for now, let's create a poisson-weighted ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["r", "TI"], "eff", 
        StyleBox["m", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "r_{\\text{eff}}^m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ba5fcc1-82f2-47e3-a9e1-6862fb8b9da8"],
 " for N <= 20:"
}], "Text",
 CellChangeTimes->{{3.9956345073452253`*^9, 3.995634515449522*^9}, {
  3.995634545656897*^9, 
  3.995634560198443*^9}},ExpressionUUID->"9ac288a1-2ab6-4011-a250-\
140bf57b762b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reffMultWeighted", " ", "=", " ", 
   RowBox[{
    RowBox[{"reffmults", " ", "*", " ", "normpois"}], " ", "//", " ", 
    "Total"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.995634564459908*^9, 3.995634584795001*^9}, 
   3.995634680884082*^9, {3.995635532191136*^9, 3.995635539425522*^9}, {
