     RowBox[{"x1", ",", "2"}], "]"}]}], 
   RowBox[{"4", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"n", "-", "x1"}], ")"}], " ", "\[Alpha]"}], "+", 
