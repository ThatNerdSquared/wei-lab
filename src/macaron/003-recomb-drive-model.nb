Cell[BoxData[
 RowBox[{
  RowBox[{"implco", "[", 
   RowBox[{"tetrad_", ",", " ", "coPair_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"temphold", " ", "=", " ", 
      RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"first", " ", "=", " ", 
      RowBox[{"coPair", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"second", " ", "=", " ", 
      RowBox[{"coPair", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"curr", " ", "=", " ", 
      RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"curr", "[", 
         RowBox[{"[", "first", "]"}], "]"}], " ", "==", " ", 
        RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tetrad", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
         RowBox[{
          RowBox[{"temphold", "[", 
           RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"curr", "[", 
          RowBox[{"[", "first", "]"}], "]"}], " ", "=", 
         RowBox[{
          RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}], "[", 
          RowBox[{"[", "first", "]"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"temphold", "[", "\"\<EmptyQ\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"temphold", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
         RowBox[{
          RowBox[{"tetrad", "[", 
           RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"curr", "[", 
         RowBox[{"[", "second", "]"}], "]"}], " ", "==", " ", 
        RowBox[{"-", "1"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"tetrad", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
         RowBox[{
          RowBox[{"temphold", "[", 
           RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"curr", "[", 
          RowBox[{"[", "second", "]"}], "]"}], " ", "=", 
         RowBox[{
          RowBox[{"tetrad", "[", "\"\<Peek\>\"", "]"}], "[", 
          RowBox[{"[", "second", "]"}], "]"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"temphold", "[", "\"\<EmptyQ\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"temphold", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
         RowBox[{
          RowBox[{"tetrad", "[", 
           RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"swapelems", "[", 
      RowBox[{"curr", ",", " ", "coPair"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9925349442491703`*^9, 3.992535037632164*^9}, {
  3.9925350845699587`*^9, 3.992535252855825*^9}},
 CellLabel->
  "In[164]:=",ExpressionUUID->"1430b0cc-79e0-4c87-8086-342ad03f3731"],

Cell["\<\
we then define a function that, given a temporal and spatial sequence of \
CO-pairs, can generate a tetrad with haplotype configurations matching the \
given sequences:\
\>", "Text",
 CellChangeTimes->{{3.9920976325943193`*^9, 3.99209765059077*^9}, {
  3.992098011100193*^9, 3.9920980555224857`*^9}, {3.992370936389112*^9, 
  3.992370937198464*^9}},ExpressionUUID->"501492c2-774d-4a65-8a83-\
3bb868a226c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"placeCOs", "[", 
   RowBox[{"tempOrd_", ",", " ", "spatOrd_"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tetrad", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"temphold", "=", 
       RowBox[{"CreateDataStructure", "[", "\"\<Stack\>\"", "]"}]}], ","}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tetrad", "[", 
      RowBox[{"\"\<Push\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1", ",", " ", "1"}], "}"}]}], 
      "]"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"initialise", " ", "chromatid", " ", "haplotypes"}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"numpops", " ", "=", " ", 
      RowBox[{"computeNumPops", "[", "spatOrd", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"currPair", " ", "=", " ", 
         RowBox[{
          RowBox[{"tempOrd", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "First"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"currTag", " ", "=", " ", 
         RowBox[{
          RowBox[{"tempOrd", "[", 
           RowBox[{"[", "i", "]"}], "]"}], " ", "//", " ", "Last"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tetrad", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
           RowBox[{
            RowBox[{"temphold", "[", 
             RowBox[{"\"\<Push\>\"", ",", " ", "#"}], "]"}], "&"}]}], ",", 
          " ", 
          RowBox[{"numpops", "[", 
           RowBox[{"[", "currTag", "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "swap", " ", "haplotypes", " ", "of", " ", "strands", " ", 
          "involved", " ", "in", " ", "the", " ", "CO"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"newhaplotypes", " ", "=", " ", 
         RowBox[{
          RowBox[{"implco", "[", 
           RowBox[{"tetrad", ",", " ", "currPair"}], "]"}], " ", "//", " ", 
          RowBox[{
           RowBox[{"blankoutelems", "[", 
            RowBox[{"#", ",", " ", "currPair"}], "]"}], "&"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tetrad", "[", 
         RowBox[{"\"\<Push\>\"", ",", " ", "newhaplotypes"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"temphold", "[", "\"\<Pop\>\"", "]"}], " ", "//", " ", 
            RowBox[{
             RowBox[{"swapelems", "[", 
              RowBox[{"#", ",", "currPair"}], "]"}], "&"}]}], " ", "//", " ", 
           
           RowBox[{
            RowBox[{"tetrad", "[", 
             RowBox[{"\"\<Push\>\"", ",", "#"}], "]"}], "&"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"numpops", "[", 
           RowBox[{"[", "currTag", "]"}], "]"}]}], "\[IndentingNewLine]", 
         "]"}], ";"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "tempOrd", "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "tetrad"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9920980585954323`*^9, 3.992098102984256*^9}, {
   3.992098221720542*^9, 3.992098255922676*^9}, {3.992098597026132*^9, 
   3.992098681004037*^9}, {3.992109066928718*^9, 3.992109099788539*^9}, {
   3.992109136531682*^9, 3.9921092045091133`*^9}, {3.992109261550447*^9, 
   3.992109262938869*^9}, {3.992109335623823*^9, 3.992109342190709*^9}, {
   3.992109669069734*^9, 3.992109676446007*^9}, {3.992109754156921*^9, 
   3.992109857050054*^9}, {3.992110121159919*^9, 3.992110214870274*^9}, {
   3.992110457386606*^9, 3.9921105169759007`*^9}, {3.992110626560472*^9, 
   3.992110693381364*^9}, {3.9921109395872383`*^9, 3.992110946992721*^9}, {
   3.9921112074479923`*^9, 3.992111256303121*^9}, {3.992111359060561*^9, 
   3.992111411461084*^9}, {3.992352255374053*^9, 3.992352272775529*^9}, {
