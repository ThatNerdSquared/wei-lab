      RowBox[{"2", " ", "*", " ", "j"}], " ", "+", " ", "1"}]}], "]"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"0", " ", "<=", " ", 
     RowBox[{
      RowBox[{"2", "*", "j"}], " ", "+", " ", "1"}], " ", "<=", " ", "n"}], 
    "}"}]}], "]"}]], "Input",
