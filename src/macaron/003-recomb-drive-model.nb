Cell["\<\
we then normalise these so they add to 1 (since we\[CloseCurlyQuote]re \
truncating all k>20):\
\>", "Text",
 CellChangeTimes->{{3.995630566210498*^9, 
  3.995630588241819*^9}},ExpressionUUID->"d6d9e743-d669-4b5e-a6e8-\
025a8a0d4d84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"normpois", " ", "=", " ", 
   FractionBox["rawpois", 
    RowBox[{"rawpois", " ", "//", " ", "Total"}]]}], ";"}]], "Input",
 CellChangeTimes->{{3.995630590546568*^9, 3.995630635532715*^9}, {
  3.995634256955824*^9, 3.995634258881483*^9}, {3.995635430866534*^9, 
